---
import PageChantier from '~/components/pages/PageChantier.astro';
import { SLUGS_CHANTIERS, type CleChantierAvecPage } from '~/i18n/slugs';

export function getStaticPaths() {
  return (Object.keys(SLUGS_CHANTIERS) as CleChantierAvecPage[]).map((cle) => ({ params: { slug: SLUGS_CHANTIERS[cle].fr }, props: { cle } }));
}

const { cle } = Astro.props as { cle: CleChantierAvecPage };
---

<PageChantier langue="fr" cle={cle} />
