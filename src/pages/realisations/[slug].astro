---
import PageChantier from '~/components/pages/PageChantier.astro';
import { CHANTIERS, type CleChantier } from '~/data/chantiers';

export function getStaticPaths() {
  return CHANTIERS.flatMap((c) => (c.slug ? [{ params: { slug: c.slug.fr }, props: { cle: c.cle } }] : []));
}

const { cle } = Astro.props as { cle: CleChantier };
---

<PageChantier langue="fr" cle={cle} />
