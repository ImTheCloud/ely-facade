---
/**
 * Pages de comparaison du haut de page : /variantes/a/, /variantes/b/, /variantes/c/ (hors Google, hors sitemap).
 * L'accueil accepte aussi ?hero=a|b|c, qui mène ici. À supprimer dès que Claudiu a choisi.
 */
import PageAccueil from '~/components/accueil/PageAccueil.astro';
import { VARIANTES_HERO, type VarianteHero } from '~/data/hero';

export function getStaticPaths() {
  return VARIANTES_HERO.map((variante) => ({ params: { variante } }));
}

const variante = Astro.params.variante as VarianteHero;
---

<PageAccueil langue="fr" variante={variante} comparaison />
