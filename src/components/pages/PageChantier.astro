---
/**
 * La page d'un chantier : la photo en grand, l'avant/après, toutes les photos (agrandissables),
 * d'autres chantiers et le devis. Seule la commune est indiquée, jamais l'adresse.
 */
import { Image, getImage } from 'astro:assets';
import AppelDevis from '../AppelDevis.astro';
import Comparateur from '../Comparateur.astro';
import Duo from '../Duo.astro';
import Icon from '../Icon.astro';
import IntroPage from '../IntroPage.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CHANTIERS, chantier as trouver, lienChantier, photo, type CleChantier } from '~/data/chantiers';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
  cle: CleChantier;
}

const { langue, cle } = Astro.props;
const textes = t(langue);
const r = textes.realisationsPage;
const c = trouver(cle);
const fiche = textes.chantiers[cle];
const commune = textes.communes[c.commune];
const base = chemin('realisations', langue);
const lien = lienChantier(cle, langue);

// Les photos regroupées par bâtiment (UMons : cour, immeuble de quatre étages, longue façade).
const groupesUmons: Record<string, number> = { 'mons-umons-cour': 0, 'mons-umons-immeuble-angle': 1, 'mons-umons-longue-facade': 2 };
const groupes =
  cle === 'umons'
    ? [0, 1, 2].map((n) => ({ titre: fiche.batiments[n], photos: c.photos.filter((p) => groupesUmons[p.split('/')[0]] === n) }))
    : [{ titre: '', photos: c.photos }];

const grandes = Object.fromEntries(
  await Promise.all(
    c.photos.map(async (chemin) => [chemin, await getImage({ src: photo(chemin), widths: [1024, 1600, 2000], format: 'webp', quality: 80 })] as const),
  ),
);

const autres = CHANTIERS.filter((autre) => autre.cle !== cle && autre.slug).slice(0, 3);
let index = 0;
---

<BaseLayout langue={langue} titre={`${fiche.titre}, ${commune} | Ely Facade`} description={fiche.texte} surPhoto>
  <IntroPage
    langue={langue}
    fil={[
      { libelle: textes.nav.realisations, href: base },
      { libelle: `${fiche.titre}, ${commune}`, href: lien },
    ]}
    surtitre={commune}
    titre={fiche.titre}
    texte={fiche.texte}
    image={c.couverture}
  />

  {
    c.paires.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="tete" data-reveal>
            <p class="surtitre">{r.avantApres}</p>
            <h2>{fiche.accroche}</h2>
          </div>
          <div class="paires">
            {c.paires.map((paire) => (
              <div class="paire" data-reveal>
                {paire.mode === 'curseur' ? (
                  <Comparateur langue={langue} paire={paire} sizes="(min-width: 1360px) 1280px, 100vw" />
                ) : (
                  <Duo langue={langue} paire={paire} sizes="(min-width: 1360px) 640px, 50vw" />
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section galerie" data-galerie>
    <div class="wrap">
      <div class="tete" data-reveal>
        <p class="surtitre">{commune}</p>
        <h2>{r.photos}</h2>
      </div>
      {
        groupes.map((groupe) => (
          <div class="galerie__groupe">
            {groupe.titre && <h3 class="galerie__titre">{groupe.titre}</h3>}
            <ul class="galerie__grille">
              {groupe.photos.map((chemin) => {
                const grande = grandes[chemin];
                const n = index++;
                return (
                  <li data-reveal style={`--delai: ${(n % 3) * 70}ms`}>
                    <a
                      href={grande.src}
                      data-photo={n}
                      data-srcset={grande.srcSet.attribute}
                      data-alt={textes.photos[chemin]}
                      aria-label={`${r.agrandir}${textes.deuxPoints}${textes.photos[chemin]}`}
                    >
                      <Image
                        src={photo(chemin)}
                        alt={textes.photos[chemin]}
                        widths={[400, 640, 900]}
                        sizes="(min-width: 1100px) 420px, (min-width: 640px) 50vw, 100vw"
                        format="webp"
                        quality={74}
                      />
                      <span class="galerie__loupe" aria-hidden="true">
                        <Icon nom="fleche-diag" taille={18} />
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    <dialog class="visionneuse" data-visionneuse aria-label={r.visionneuse}>
      <figure class="visionneuse__cadre">
        <img data-grande alt="" />
        <figcaption data-legende></figcaption>
      </figure>
      <button type="button" class="visionneuse__bouton visionneuse__fermer" data-fermer aria-label={r.fermer}>
        <span aria-hidden="true">×</span>
      </button>
      <button type="button" class="visionneuse__bouton visionneuse__precedente" data-precedente aria-label={r.precedente}>
        <Icon nom="fleche-gauche" taille={22} />
      </button>
      <button type="button" class="visionneuse__bouton visionneuse__suivante" data-suivante aria-label={r.suivante}>
        <Icon nom="fleche" taille={22} />
      </button>
    </dialog>
  </section>

  <section class="section autres">
    <div class="wrap">
      <div class="autres__tete" data-reveal>
        <h2>{r.autres}</h2>
        <a href={base}>
          {r.retour}
          <Icon nom="fleche" taille={18} />
        </a>
      </div>
      <ul class="autres__liste">
        {
          autres.map((autre) => (
            <li data-reveal>
              <a href={lienChantier(autre.cle, langue)}>
                <Image src={photo(autre.couverture)} alt={textes.photos[autre.couverture]} widths={[400, 640]} sizes="(min-width: 900px) 33vw, 100vw" format="webp" quality={72} />
                <span class="autres__commune">{textes.communes[autre.commune]}</span>
                <span class="autres__titre">{textes.chantiers[autre.cle].titre}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <AppelDevis langue={langue} titre={r.devis.titre} texte={r.devis.texte} />
</BaseLayout>

<script>
  import '~/scripts/visionneuse';
</script>

<style>
  .paires {
    display: grid;
    gap: var(--tile-gap);
  }

  /* --- Galerie --- */
  .galerie {
    padding-top: 0;
  }

  .galerie__groupe + .galerie__groupe {
    margin-top: 48px;
  }

  .galerie__titre {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 800;
  }

  .galerie__titre::before {
    content: '';
    width: 14px;
    height: 7px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .galerie__grille {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .galerie__grille a {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
  }

  .galerie__grille :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .galerie__grille a:hover :global(img) {
    transform: scale(1.05);
  }

  .galerie__grille a:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .galerie__loupe {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--speed) var(--ease),
      transform var(--speed) var(--ease);
  }

  .galerie__grille a:hover .galerie__loupe,
  .galerie__grille a:focus-visible .galerie__loupe {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 640px) {
    .galerie__grille {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .galerie__grille {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* --- Visionneuse --- */
  .visionneuse {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(14, 20, 28, 0.94);
    color: #fff;
  }

  .visionneuse::backdrop {
    background: rgba(14, 20, 28, 0.6);
  }

  .visionneuse__cadre {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: 100%;
    margin: 0;
    padding: 72px 16px 32px;
  }

  .visionneuse__cadre img {
    max-width: 100%;
    max-height: calc(100% - 48px);
    object-fit: contain;
    border-radius: 12px;
  }

  .visionneuse__cadre figcaption {
    max-width: 60ch;
    font-size: var(--size-small);
    text-align: center;
    color: rgba(255, 255, 255, 0.86);
  }

  .visionneuse__bouton {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  .visionneuse__bouton:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .visionneuse__bouton:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .visionneuse__fermer {
    top: 16px;
    right: 16px;
  }

  .visionneuse__precedente,
  .visionneuse__suivante {
    top: 50%;
    margin-top: -26px;
  }

  .visionneuse__precedente {
    left: 16px;
  }

  .visionneuse__suivante {
    right: 16px;
  }

  @media (max-width: 699px) {
    .visionneuse__precedente,
    .visionneuse__suivante {
      top: auto;
      bottom: 20px;
      margin-top: 0;
    }

    .visionneuse__cadre {
      padding-bottom: 96px;
    }
  }

  /* --- Autres chantiers --- */
  .autres__tete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: 28px;
  }

  .autres__tete h2 {
    font-size: clamp(30px, 3.6vw, 52px);
  }

  .autres__tete a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .autres__tete a:hover {
    color: var(--color-accent);
  }

  .autres__liste {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .autres__liste a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .autres__liste :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-tile);
    margin-bottom: 12px;
    transition: transform var(--speed) var(--ease);
  }

  .autres__liste a:hover :global(img) {
    transform: translateY(-4px);
  }

  .autres__commune {
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .autres__titre {
    font-weight: 700;
    font-size: var(--size-lead);
  }

  @media (min-width: 900px) {
    .autres__liste {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
