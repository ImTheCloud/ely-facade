---
/** La page « Services » : les dix métiers de la façade et leurs détails sur une seule page, sans page par métier. Données structurées « Service » pour chacun. */
import AppelDevis from '../AppelDevis.astro';
import Icon from '../Icon.astro';
import IntroPage from '../IntroPage.astro';
import Methode from '../accueil/Methode.astro';
import Atouts from './Atouts.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { entreprise, idEntreprise } from '~/data/entreprise';
import { METIERS } from '~/data/metiers';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const page = textes.pages.services;
const s = textes.services;
const lienPage = chemin('services', langue);

const donnees = METIERS.map((metier) => {
  const m = textes.metiers[metier.cle];
  return {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: m.titre,
    serviceType: m.titre,
    description: m.description,
    url: new URL(`${lienPage}#${metier.cle}`, Astro.site).href,
    areaServed: { '@type': 'Country', name: textes.pays },
    provider: {
      '@type': 'GeneralContractor',
      '@id': idEntreprise(Astro.site!),
      name: entreprise.nomCourt,
      telephone: entreprise.telephoneLien,
      url: new URL(chemin('accueil', langue), Astro.site).href,
    },
  };
});
---

<BaseLayout langue={langue} titre={page.titre} description={page.description} surPhoto>
  <script type="application/ld+json" set:html={JSON.stringify(donnees)} />

  <IntroPage
    langue={langue}
    fil={[{ libelle: textes.nav.services, href: lienPage }]}
    titre={s.titre}
    texte={s.texte}
    image="mons-umons-longue-facade/apres"
  />

  <section class="section metiers">
    <div class="wrap">
      <ul class="metiers__grille">
        {
          METIERS.map((metier) => {
            const m = textes.metiers[metier.cle];
            return (
              <li class="metier tuile-bento" id={metier.cle}>
                <details class="metier__details" open>
                  <summary>
                    <span class="metier__tete">
                      <span class="metier__icone">
                        <Icon nom={metier.icone} taille={24} />
                      </span>
                      <h2>{m.titre}</h2>
                      <span class="metier__chevron" aria-hidden="true">
                        <Icon nom="chevron" taille={20} />
                      </span>
                    </span>
                    <span class="metier__court">{m.court}</span>
                  </summary>
                  <ul class="metier__points">
                    {m.points.map((point) => (
                      <li>
                        <span class="metier__coche" aria-hidden="true">
                          <Icon nom="check" taille={14} epaisseur={2.8} />
                        </span>
                        {point}
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <Atouts langue={langue} />
  <Methode langue={langue} />
  <AppelDevis langue={langue} titre={s.devis.titre} texte={s.devis.texte} />
</BaseLayout>

<style>
  .metiers__grille {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .metier {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    scroll-margin-top: 100px;
  }

  .metier__tete {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .metier__icone {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .metier h2 {
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.1;
  }

  .metier__court {
    display: block;
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-text);
  }

  .metier__points {
    display: grid;
    gap: 6px;
    margin: 4px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-muted);
  }

  .metier__points li {
    display: flex;
    gap: 8px;
  }

  .metier__coche {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .metier__details > summary {
    display: block;
    list-style: none;
    cursor: pointer;
  }

  .metier__details > summary::-webkit-details-marker {
    display: none;
  }

  .metier__details > summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 12px;
  }

  .metier__chevron {
    display: none;
    flex: none;
    margin-left: auto;
    transition: transform var(--speed) var(--ease);
  }

  /* Téléphone : chaque carte se replie (chevron) pour moins défiler ; sans JavaScript, tout reste ouvert. */
  @media (max-width: 699px) {
    .metiers__grille {
      gap: 10px;
    }

    .metier {
      padding: 14px 16px;
    }

    .metier__icone {
      width: 36px;
      height: 36px;
      border-radius: 11px;
    }

    .metier__tete {
      margin-bottom: 6px;
    }

    .metier__chevron {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin: -8px -10px -8px auto;
      color: var(--color-ink);
    }

    .metier__details[open] .metier__chevron {
      transform: rotate(180deg);
    }

    .metier__points {
      margin-top: 10px;
      padding-top: 10px;
      font-size: 13.5px;
      line-height: 1.35;
    }
  }

  /* Ordinateur : tout est toujours ouvert, rien à cliquer. */
  @media (min-width: 700px) {
    .metier__details > summary {
      pointer-events: none;
      cursor: default;
    }
  }

  @media (min-width: 700px) {
    .metiers__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .metiers__grille {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Téléphone : les cartes démarrent repliées (sauf celle visée par l'adresse, ex. /services/#crepi) ; ordinateur : tout ouvert.
  const mobile = window.matchMedia('(max-width: 699px)');
  const cartes = document.querySelectorAll<HTMLDetailsElement>('.metier__details');
  const viser = () => {
    const cible = location.hash && document.querySelector<HTMLElement>(`.metier${location.hash}`);
    cartes.forEach((c) => (c.open = !mobile.matches || c.closest('li') === cible));
  };
  viser();
  mobile.addEventListener('change', viser);
  window.addEventListener('hashchange', viser);
</script>
