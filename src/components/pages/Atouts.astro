---
/** « Pour tous les bâtiments » et les quatre engagements, communs aux pages Services et métier. */
import { t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
  /** Afficher le bloc des matériaux (crépi, peinture). */
  materiaux?: boolean;
}

const { langue, materiaux = false } = Astro.props;
const s = t(langue).services;
---

<section class="section atouts">
  <div class="wrap atouts__grille">
    <div class="atouts__texte">
      <h2>{s.pourQui.titre}</h2>
      <p>{s.pourQui.texte}</p>
      {
        materiaux && (
          <div class="atouts__materiaux">
            <h3>{s.materiaux.titre}</h3>
            <p>{s.materiaux.texte}</p>
          </div>
        )
      }
    </div>
    <ul class="atouts__liste">
      {
        s.atouts.map((atout) => (
          <li>
            <span class="brique" aria-hidden="true" />
            <h3>{atout.titre}</h3>
            <p>{atout.texte}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .atouts {
    border-top: 1px solid var(--color-border);
  }

  .atouts__grille {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  .atouts__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .atouts__texte > p {
    max-width: 46ch;
    font-size: var(--size-lead);
  }

  .atouts__materiaux {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
    padding: 22px 24px;
    border-radius: var(--radius-md);
    background: var(--color-card);
    border: 1px solid var(--color-border);
  }

  .atouts__liste {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .atouts__liste li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tile);
    background: var(--color-card);
    box-shadow: var(--shadow-tile);
  }

  .atouts__liste .brique {
    margin-bottom: 8px;
  }

  @media (min-width: 640px) {
    .atouts__liste {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .atouts__grille {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 64px;
    }
  }
</style>
