---
/**
 * Icônes SVG au trait. Toutes au même endroit pour garder un style unique.
 */
export type NomIcone =
  | 'fleche'
  | 'fleche-diag'
  | 'fleche-gauche'
  | 'check'
  | 'autre'
  | 'telephone'
  | 'email'
  | 'whatsapp'
  | 'truelle'
  | 'rouleau'
  | 'goutte'
  | 'joint'
  | 'brique'
  | 'facade'
  | 'isolation'
  | 'fissure'
  | 'echafaudage'
  | 'croix'
  | 'toucher'
  | 'regle';

interface Props {
  nom: NomIcone;
  taille?: number;
  epaisseur?: number;
  class?: string;
}

const { nom, taille = 20, epaisseur = 1.8, class: classe } = Astro.props;

const chemins: Record<NomIcone, string> = {
  fleche: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
  'fleche-diag': '<path d="M7 17L17 7"/><path d="M8 7h9v9"/>',
  'fleche-gauche': '<path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  isolation:
    '<rect x="3" y="4" width="5" height="16" rx="1"/><path d="M8 8h3M8 12h3M8 16h3"/><path d="M14 4h7v16h-7z"/><path d="M14 9h7M14 15h7"/>',
  fissure: '<path d="M12 3l-2.5 5 4 3-3.5 4.5 2.5 2.5-1 3"/><path d="M4 21h16"/>',
  echafaudage:
    '<path d="M5 3v18M19 3v18"/><path d="M5 8h14M5 14h14"/><path d="M5 8l14 6M5 14L19 8"/>',
  toucher:
    '<path d="M9 11V5.5a1.8 1.8 0 0 1 3.6 0V10l4.6 1.2a2 2 0 0 1 1.5 2.2l-.7 4.6A2.5 2.5 0 0 1 15.5 20H12a2.5 2.5 0 0 1-2-1l-3.6-4.8a1.6 1.6 0 0 1 2.5-2L9 13.3"/>',
  croix: '<path d="M6 6l12 12M18 6L6 18"/>',
  regle: '<rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6.5 8v3M10.5 8v4M14.5 8v3M18.5 8v4"/>',
  facade:
    '<path d="M4 21V7l8-4 8 4v14"/><path d="M2.5 21h19"/><path d="M8 10h2M14 10h2M8 14h2M14 14h2"/><path d="M10.5 21v-3.5h3V21"/>',
  autre: '<circle cx="6" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="18" cy="12" r="1.2"/>',
  telephone:
    '<path d="M6 3h3.5l1.8 4.6-2.3 1.5a11.5 11.5 0 0 0 5.9 5.9l1.5-2.3L21 14.5V18a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7.5l8 5.5 8-5.5"/>',
  whatsapp:
    '<path d="M4 20l1.3-4.2A8.5 8.5 0 1 1 8.4 19z"/><path d="M9 8.5c0 3.2 3.3 6.5 6.5 6.5l1-1.6-2-1-1 .9a5 5 0 0 1-2.8-2.8l.9-1-1-2z"/>',
  truelle: '<path d="M3 21l6-6"/><path d="M9 15l-1.5-1.5 9-9a2.1 2.1 0 0 1 3 3l-9 9L9 15z"/><path d="M7.5 13.5l3 3"/>',
  rouleau: '<rect x="4" y="3" width="14" height="6" rx="1.5"/><path d="M18 6h2v5h-8v3"/><rect x="10.5" y="14" width="3" height="7" rx="1"/>',
  goutte: '<path d="M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/><path d="M9.5 15a2.5 2.5 0 0 0 2.5 2.5"/>',
  joint: '<path d="M3 9h11"/><path d="M3 15h18"/><path d="M3 20.5h18"/><path d="M8.5 9v6"/><path d="M14 15v5.5"/><path d="M15.5 3.5l5 5-2.6.9-3.3-3.3z"/>',
  brique: '<rect x="3" y="4" width="18" height="16" rx="1.5"/><path d="M3 9.3h18"/><path d="M3 14.6h18"/><path d="M9 4v5.3"/><path d="M15 9.3v5.3"/><path d="M9 14.6V20"/>',
};
---

<svg
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={epaisseur}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={classe}
  set:html={chemins[nom]}
/>
