---
/**
 * Carte de la Belgique (dessin simplifié, pas une carte exacte) : le bureau de Halle (brique rouge) et les communes
 * de quelques-uns de nos chantiers (points sombres). On touche une commune pour voir ses chantiers sous la carte.
 * Les points sont de vrais boutons posés sur le dessin ; sans JavaScript, la carte reste lisible et les chantiers
 * sont dans la bande de photos juste dessous.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { CHANTIERS, lienChantier, photo, type Commune } from '../data/chantiers';
import { t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  class?: string;
}

const { langue, class: classe } = Astro.props;
const textes = t(langue);
const carte = textes.accueil.realisations.carte;

const LARGEUR = 560;
const HAUTEUR = 460;
/** Longitude, latitude → coordonnées du dessin (projection simple, latitude moyenne 50,6°). */
const X = (lon: number) => Math.round((lon - 2.45) * 137 * 10) / 10;
const Y = (lat: number) => Math.round((51.56 - lat) * 216 * 10) / 10;
const pct = (v: number, total: number) => `${Math.round((v / total) * 1000) / 10}%`;
const place = (lon: number, lat: number) => `left: ${pct(X(lon), LARGEUR)}; top: ${pct(Y(lat), HAUTEUR)}`;

// Frontière simplifiée : côte, Pays-Bas, Allemagne, Luxembourg, France.
const frontiere: [number, number][] = [
  [2.545, 51.089], [2.75, 51.17], [3.03, 51.25], [3.37, 51.37], [3.52, 51.29], [3.79, 51.26], [3.98, 51.24],
  [4.24, 51.37], [4.39, 51.36], [4.53, 51.48], [4.67, 51.43], [4.86, 51.48], [5.06, 51.47], [5.1, 51.36],
  [5.24, 51.31], [5.48, 51.3], [5.67, 51.18], [5.84, 51.16], [5.75, 51.04], [5.77, 50.95], [5.69, 50.8],
  [5.68, 50.76], [5.98, 50.76], [6.02, 50.75], [6.09, 50.72], [6.26, 50.64], [6.18, 50.55], [6.36, 50.48],
  [6.4, 50.33], [6.25, 50.3], [6.14, 50.14], [6.03, 50.17], [5.97, 50.07], [5.87, 50.02], [5.77, 49.88],
  [5.74, 49.8], [5.9, 49.66], [5.82, 49.55], [5.47, 49.5], [5.31, 49.63], [5.1, 49.77], [4.86, 49.8],
  [4.86, 49.95], [4.88, 50.15], [4.7, 50.1], [4.68, 49.99], [4.43, 49.94], [4.15, 49.98], [4.21, 50.27],
  [3.87, 50.33], [3.71, 50.31], [3.66, 50.45], [3.29, 50.53], [3.23, 50.71], [3.04, 50.78], [2.86, 50.7],
  [2.66, 50.81], [2.55, 50.94],
];
// Contour adouci (courbe de Catmull-Rom passant par chaque point) : un dessin épuré plutôt qu'une ligne brisée.
const pts = frontiere.map(([lon, lat]) => [X(lon), Y(lat)]);
const r1 = (v: number) => Math.round(v * 10) / 10;
const trace =
  `M${pts[0][0]} ${pts[0][1]}` +
  pts
    .map((p1, i) => {
      const p0 = pts[(i - 1 + pts.length) % pts.length];
      const p2 = pts[(i + 1) % pts.length];
      const p3 = pts[(i + 2) % pts.length];
      const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
      const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
      return `C${r1(c1[0])} ${r1(c1[1])} ${r1(c2[0])} ${r1(c2[1])} ${p2[0]} ${p2[1]}`;
    })
    .join('') +
  'Z';

/** Les communes de nos chantiers. cote : de quel côté du point s'écrit son nom. */
const communes: { commune: Commune; lon: number; lat: number; cote: 'gauche' | 'droite' | 'bas'; dx?: number; dy?: number }[] = [
  { commune: 'namur', lon: 4.867, lat: 50.466, cote: 'droite' },
  { commune: 'mons', lon: 3.952, lat: 50.455, cote: 'gauche' },
  { commune: 'charleroi', lon: 4.444, lat: 50.411, cote: 'bas' },
  // Halle : le point du chantier est posé un peu à côté du bureau, pour ne pas le recouvrir.
  { commune: 'halle', lon: 4.235, lat: 50.735, cote: 'droite', dx: 18, dy: 16 },
  { commune: 'evere', lon: 4.402, lat: 50.87, cote: 'droite' },
];
const bureau = { lon: 4.235, lat: 50.735 };
/** Quelques grandes villes, seulement pour se repérer. */
const villes = [
  { nom: carte.villes.anvers, lon: 4.4, lat: 51.22, cote: 'droite' },
  { nom: carte.villes.gand, lon: 3.72, lat: 51.05, cote: 'gauche' },
  { nom: carte.villes.liege, lon: 5.57, lat: 50.63, cote: 'droite' },
];

const fiches = communes.map((c) => ({
  ...c,
  chantiers: CHANTIERS.filter((chantier) => chantier.commune === c.commune),
}));
const identifiant = 'carte';
---

<figure class:list={['carte', classe]} data-reveal data-carte>
  <div class="carte__dessin">
    <svg viewBox={`0 0 ${LARGEUR} ${HAUTEUR}`} role="img" aria-label={carte.aria}>
      <defs>
        <linearGradient id={`${identifiant}-fond`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="1" stop-color="#f1f1ee" />
        </linearGradient>
        <pattern id={`${identifiant}-points`} width="11" height="11" patternUnits="userSpaceOnUse">
          <circle cx="1.6" cy="1.6" r="1.1" fill="#1f2429" fill-opacity="0.09" />
        </pattern>
        <clipPath id={`${identifiant}-pays`}><path d={trace}></path></clipPath>
      </defs>
      <path class="carte__ombre" d={trace}></path>
      <path d={trace} fill={`url(#${identifiant}-fond)`}></path>
      <rect width={LARGEUR} height={HAUTEUR} fill={`url(#${identifiant}-points)`} clip-path={`url(#${identifiant}-pays)`}></rect>
      <path class="carte__pays" d={trace}></path>
    </svg>

    <div class="carte__reperes" aria-hidden="true">
      {
        villes.map((ville) => (
          <span class={`ville ville--${ville.cote}`} style={place(ville.lon, ville.lat)}>
            <i></i>
            <span>{ville.nom}</span>
          </span>
        ))
      }
    </div>

    <!-- Le bureau de Halle : le logo de l'entreprise, le nom en rouge. -->
    <div class="bureau" style={place(bureau.lon, bureau.lat)}>
      <span class="bureau__onde" aria-hidden="true"></span>
      <span class="bureau__point" aria-hidden="true"></span>
      <span class="bureau__carte">
        <Logo class="bureau__logo" />
        <span class="bureau__nom">{carte.bureau}</span>
      </span>
    </div>

    <div class="carte__points">
      {
        fiches.map((fiche, i) => (
          <button
            type="button"
            class:list={['point', `point--${fiche.cote}`, { 'est-actif': i === 0 }]}
            style={`${place(fiche.lon, fiche.lat)}; --i: ${i}; --dx: ${fiche.dx ?? 0}px; --dy: ${fiche.dy ?? 0}px`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-controls={`${identifiant}-${fiche.commune}`}
            data-point={fiche.commune}
          >
            <span class="point__rond" aria-hidden="true"></span>
            <span class="point__nom">{textes.communes[fiche.commune]}</span>
          </button>
        ))
      }
    </div>
  </div>

  <ul class="carte__legende" aria-hidden="true">
    <li><span class="legende__point"></span>{carte.bureauHalle}</li>
    <li><span class="legende__rond"></span>{carte.chantier}</li>
  </ul>

  <!-- Téléphone : les communes se choisissent aussi ici, plus faciles à toucher que les points serrés de la carte. -->
  <div class="carte__choix" role="group" aria-label={textes.accueil.realisations.pastille}>
    {
      fiches.map((fiche, i) => (
        <button type="button" class:list={['choix', { 'est-actif': i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`${identifiant}-${fiche.commune}`} data-point={fiche.commune}>
          {textes.communes[fiche.commune]}
        </button>
      ))
    }
  </div>

  <div class="carte__fiches">
    {
      fiches.map((fiche, i) => (
        <div class:list={['fiche', { 'est-actif': i === 0 }]} id={`${identifiant}-${fiche.commune}`} role="group" aria-label={textes.communes[fiche.commune]} data-fiche={fiche.commune}>
          {fiche.chantiers.map((c) => {
            const infos = textes.chantiers[c.cle];
            const contenu = (
              <>
                <Image
                  src={photo(c.couverture)}
                  alt={textes.photos[c.couverture]}
                  widths={[160, 240, 320]}
                  sizes="120px"
                  format="webp"
                  quality={72}
                  loading="lazy"
                />
                <span class="fiche__texte">
                  <span class="fiche__commune">{textes.communes[c.commune]}</span>
                  <span class="fiche__titre">{infos.titre}</span>
                  {c.slug && (
                    <span class="fiche__voir">
                      {textes.accueil.realisations.voir}
                      <Icon nom="fleche" taille={16} />
                    </span>
                  )}
                </span>
              </>
            );
            return c.slug ? (
              <a class="fiche__chantier" href={lienChantier(c.cle, langue)}>
                {contenu}
              </a>
            ) : (
              <div class="fiche__chantier">{contenu}</div>
            );
          })}
        </div>
      ))
    }
  </div>
</figure>

<script>
  import '~/scripts/carte';
</script>

<style>
  .carte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }

  .carte__dessin {
    position: relative;
    aspect-ratio: 560 / 460;
  }

  .carte svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .carte__ombre {
    fill: rgba(31, 36, 41, 0.14);
    filter: blur(14px);
    transform: translateY(14px);
  }

  .carte__pays {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  /* --- Repères : grandes villes, discrètes --- */
  .carte__reperes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ville {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-muted);
    transform: translate(-3px, -50%);
    white-space: nowrap;
  }

  .ville i {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--color-muted);
    border-radius: 50%;
    background: #fff;
  }

  .ville--gauche {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 3px), -50%);
  }

  /* --- Le bureau : le logo, le nom en rouge --- */
  .bureau {
    position: absolute;
    display: flex;
    align-items: center;
    flex-direction: row-reverse;
    gap: 6px;
    transform: translate(calc(-100% + 8px), -50%);
    pointer-events: none;
  }

  .bureau__point {
    position: relative;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 4px 10px -2px rgba(200, 32, 43, 0.7);
  }

  .bureau__onde {
    position: absolute;
    right: 0;
    top: 50%;
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border-radius: 50%;
    background: rgba(200, 32, 43, 0.16);
    transform: translateX(calc(50% - 8px));
  }

  .bureau__carte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    padding: 6px 10px 5px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 6px 16px -6px rgba(31, 36, 41, 0.4);
  }

  .bureau .bureau__carte :global(.logo) {
    height: 20px;
  }

  .bureau__nom {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-accent);
    white-space: nowrap;
  }

  /* --- Les communes de chantiers : de vrais boutons, zone tactile de 44 px --- */
  .carte__points {
    position: absolute;
    inset: 0;
  }

  .point {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 2px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    cursor: pointer;
    transform: translate(calc(-22px + var(--dx)), calc(-50% + var(--dy)));
  }

  .point--gauche {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 22px + var(--dx)), calc(-50% + var(--dy)));
  }

  /* Le nom sous le point (communes trop proches pour écrire à côté). */
  .point--bas {
    flex-direction: column;
    align-items: center;
    gap: 0;
    transform: translate(calc(-50% + var(--dx)), calc(-22px + var(--dy)));
  }

  .point--bas .point__nom {
    margin-top: -6px;
  }

  .point__rond {
    position: relative;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
  }

  .point__rond::before {
    content: '';
    position: absolute;
    inset: 12px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 4px 12px -2px rgba(31, 36, 41, 0.5);
    transition:
      transform var(--speed) var(--ease),
      background-color var(--speed) var(--ease);
  }

  .point__nom {
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 1px 2px rgba(31, 36, 41, 0.1);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition:
      background-color var(--speed) var(--ease),
      color var(--speed) var(--ease);
  }

  .point:hover .point__rond::before {
    transform: scale(1.18);
  }

  .point.est-actif .point__rond::before {
    background: var(--color-accent);
    transform: scale(1.3);
  }

  .point.est-actif .point__nom {
    background: var(--color-ink);
    color: #fff;
  }

  .point:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 12px;
  }

  /* --- Légende --- */
  .carte__legende {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--size-tiny);
    font-weight: 600;
    color: var(--color-text);
  }

  .carte__legende li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .legende__point {
    width: 13px;
    height: 13px;
    border: 2.5px solid #fff;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .legende__rond {
    width: 13px;
    height: 13px;
    border: 2.5px solid #fff;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  /* --- Choix de la commune (téléphone) --- */
  .carte__choix {
    display: none;
    flex-wrap: wrap;
    gap: 8px;
  }

  .choix {
    min-height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-card);
    color: var(--color-ink);
    font: 650 15px/1 var(--font-text);
    cursor: pointer;
    transition:
      background-color var(--speed) var(--ease),
      color var(--speed) var(--ease),
      border-color var(--speed) var(--ease);
  }

  .choix.est-actif {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }

  .choix:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 699px) {
    :global(.js) .carte__choix {
      display: flex;
    }
  }

  /* --- La fiche de la commune choisie --- */
  .carte__fiches {
    display: grid;
  }

  .fiche {
    display: none;
    gap: 10px;
  }

  .fiche.est-actif {
    display: grid;
  }

  .fiche__chantier {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-card);
    box-shadow: var(--shadow-tile);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--speed) var(--ease),
      box-shadow var(--speed) var(--ease);
  }

  a.fiche__chantier:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  a.fiche__chantier:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .fiche__chantier :global(img) {
    flex-shrink: 0;
    width: 112px;
    height: 84px;
    object-fit: cover;
    border-radius: 12px;
  }

  .fiche__texte {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .fiche__commune {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .fiche__titre {
    font-weight: 650;
    color: var(--color-ink);
  }

  .fiche__voir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-size: var(--size-small);
    font-weight: 700;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .point,
    :global(.js) .bureau,
    :global(.js) .ville {
      opacity: 0;
      transition: opacity 600ms var(--ease-out);
      transition-delay: calc(300ms + var(--i, 0) * 180ms);
    }

    :global(.js) .carte.est-visible .point,
    :global(.js) .carte.est-visible .bureau,
    :global(.js) .carte.est-visible .ville {
      opacity: 1;
    }

    .bureau__onde {
      animation: onde 2.8s var(--ease-out) infinite;
    }

    .fiche.est-actif {
      animation: fiche-entre 420ms var(--ease-out);
    }

    @keyframes onde {
      from {
        transform: translateX(calc(50% - 8px)) scale(0.4);
        opacity: 1;
      }
      to {
        transform: translateX(calc(50% - 8px)) scale(1.5);
        opacity: 0;
      }
    }

    @keyframes fiche-entre {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
    }
  }

  /* Téléphone : pas de noms sur la carte (trop serrés), les communes se choisissent sous la carte. */
  @media (max-width: 699px) {
    .point__nom,
    .bureau__nom {
      display: none;
    }

    .bureau .bureau__carte {
      padding: 5px 8px;
    }

    .bureau .bureau__carte :global(.logo) {
      height: 16px;
    }

    .point,
    .point--bas {
      min-width: 40px;
      min-height: 40px;
      transform: translate(calc(-20px + var(--dx)), calc(-50% + var(--dy)));
    }

    .point__rond {
      width: 40px;
      height: 40px;
    }

    .point__rond::before {
      inset: 10px;
    }

    .fiche__chantier :global(img) {
      width: 92px;
      height: 72px;
    }
  }
</style>
