---
/**
 * Le logo (SVG du dossier assets/marque), maison en briques et nom.
 * Le texte alternatif est vide : le lien qui l'entoure porte déjà son aria-label.
 */
import logo from '~/assets/marque/logo.svg';

interface Props {
  class?: string;
}

const { class: classe } = Astro.props;
---

<img src={logo.src} width={logo.width} height={logo.height} alt="" class:list={['logo', classe]} />

<style>
  .logo {
    display: block;
    width: auto;
    height: 34px;
  }

  @media (min-width: 1024px) {
    .logo {
      height: 46px;
    }
  }
</style>
