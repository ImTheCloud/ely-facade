---
/**
 * Pied de page : un grand bloc gris perle aux coins du haut arrondis, avec
 * les coordonnées, la navigation, le sélecteur de langue, le QR code des avis Google (#avis) et les mentions légales.
 */
import QRCode from 'qrcode';
import Bouton from './Bouton.astro';
import Logo from './Logo.astro';
import SelecteurLangue from './SelecteurLangue.astro';
import { entreprise, lienItineraire, lienWhatsApp } from '../data/entreprise';
import { lienAvisGoogle } from '../data/google';
import { chemin, liensNavigation, t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  cheminActuel: string;
}

const { langue, cheminActuel } = Astro.props;
const textes = t(langue);
const pied = textes.piedDePage;
const liens = liensNavigation(langue);

/** Le concepteur du site (crédit en bas de page). */
const CONCEPTEUR = { nom: 'Claudiu Popadiuc', email: 'claudiu.dev@outlook.com' };
const mailConcepteur = `mailto:${CONCEPTEUR.email}?subject=${encodeURIComponent(pied.creditSujet)}`;

// Le QR code est dessiné à la construction du site : aucun service extérieur, il encode directement le lien d'avis.
// Elisei ouvre n'importe quelle page, descend tout en bas, et le client scanne.
const qr = QRCode.create(lienAvisGoogle, { errorCorrectionLevel: 'M' });
const n = qr.modules.size;
const marge = 2;
let cases = '';
for (let y = 0; y < n; y++) for (let x = 0; x < n; x++) if (qr.modules.get(x, y)) cases += `M${x + marge} ${y + marge}h1v1h-1z`;
const cote = n + 2 * marge;
---

<footer class="pied">
  <div class="wrap">
    <div class="pied__haut">
      <a href={chemin('accueil', langue)} class="pied__logo" aria-label={textes.entete.accueilAria}>
        <Logo />
      </a>
      <SelecteurLangue langue={langue} cheminActuel={cheminActuel} etiquette={textes.piedDePage.languesAria} />
    </div>

    <div class="pied__colonnes">
      <nav class="pied__col" aria-label={textes.piedDePage.menuAria}>
        <span class="pied__titre">{textes.entete.menu}</span>
        {liens.map((lien) => <a href={lien.href}>{lien.libelle}</a>)}
      </nav>

      <div class="pied__col">
        <span class="pied__titre">{textes.entete.contactDirect}</span>
        <a href={`tel:${entreprise.telephoneLien}`}>{entreprise.telephoneAffiche}</a>
        <a href={lienWhatsApp(textes.whatsappMessage)} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`mailto:${entreprise.email}`} class="pied__email">{entreprise.email}</a>
      </div>

      <div class="pied__col">
        <span class="pied__titre">{pied.entreprise}</span>
        <span>{entreprise.nomCourt}</span>
        <a href={lienItineraire} target="_blank" rel="noopener">{entreprise.rue}<br />{entreprise.codePostal} {entreprise.ville}</a>
      </div>
    </div>

    <div class="pied__avis" id="avis">
      <svg
        class="pied__code"
        viewBox={`0 0 ${cote} ${cote}`}
        shape-rendering="crispEdges"
        role="img"
        aria-label={pied.avis.alt}
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect width={cote} height={cote} fill="#fff"></rect>
        <path d={cases} fill="#1f2429"></path>
      </svg>
      <div class="pied__avis-texte">
        <h2>{pied.avis.titre}</h2>
        <p>{pied.avis.texte}</p>
        <Bouton href={lienAvisGoogle} variante="secondaire" iconeApres="fleche-diag" target="_blank" rel="noopener">{pied.avis.bouton}</Bouton>
      </div>
    </div>

    <div class="pied__bas">
      <p>© 2026 {entreprise.nomCourt}. {pied.droits}</p>
      <nav class="pied__legal" aria-label={pied.mentionsLegales}>
        <a href={chemin('mentionsLegales', langue)}>{pied.mentionsLegales}</a>
        <a href={chemin('viePrivee', langue)}>{pied.viePrivee}</a>
      </nav>
    </div>

    <p class="pied__credit">
      {pied.credit} <a href={mailConcepteur}>{CONCEPTEUR.nom}</a> · {pied.creditQuestion} <a href={mailConcepteur}>{CONCEPTEUR.email}</a>
    </p>
  </div>
</footer>

<style>
  .pied {
    margin-top: var(--section-gap);
    padding: 48px 0 calc(110px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border);
  }

  .pied__haut {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--color-border);
  }

  .pied__logo {
    display: inline-flex;
  }

  .pied__logo :global(.logo) {
    height: 40px;
  }

  .pied__colonnes {
    display: grid;
    gap: 32px;
    padding-block: 36px;
  }

  .pied__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    font-size: var(--size-small);
    color: var(--color-text);
  }

  .pied__titre {
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-muted);
  }

  .pied__col a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink);
    font-weight: 550;
    text-decoration: none;
  }

  .pied__col a:hover {
    color: var(--color-accent);
  }

  .pied__email {
    overflow-wrap: anywhere;
  }

  .pied__avis {
    display: grid;
    justify-items: center;
    gap: 20px;
    padding-block: 32px;
    border-top: 1px solid var(--color-border);
    text-align: center;
    scroll-margin-top: 24px;
  }

  .pied__code {
    width: min(190px, 60vw);
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }

  .pied__avis-texte {
    display: grid;
    justify-items: center;
    gap: 12px;
    max-width: 44ch;
  }

  .pied__avis-texte h2 {
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.1;
  }

  .pied__avis-texte p {
    margin: 0;
    font-size: var(--size-small);
  }

  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    font-size: var(--size-tiny);
    color: var(--color-muted);
  }

  .pied__legal {
    display: flex;
    gap: 20px;
  }

  .pied__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
  }

  .pied__legal a:hover {
    color: var(--color-ink);
  }

  .pied__credit {
    margin-top: 12px;
    font-size: var(--size-tiny);
    line-height: 1.6;
    color: var(--color-muted);
  }

  .pied__credit a {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: color var(--speed) var(--ease), text-decoration-color var(--speed) var(--ease);
  }

  .pied__credit a:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .pied {
      padding-top: 64px;
      border-radius: 48px 48px 0 0;
    }

    .pied__colonnes {
      grid-template-columns: repeat(3, 1fr);
    }

    .pied__avis {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      gap: 40px;
      text-align: left;
    }

    .pied__avis-texte {
      justify-items: start;
    }
  }
</style>
