---
/** Comment ça se passe, de l'appel à la dernière finition : quatre étapes reliées par un trait. */
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const methode = t(langue).accueil.methode;
---

<section class="section methode" id="methode">
  <div class="wrap">
    <div class="tete" data-reveal>
      <h2>{methode.titre}</h2>
    </div>

    <!-- Une vraie liste ordonnée : les numéros sont aussi lus par les lecteurs d'écran. -->
    <ol class="methode__etapes">
      {
        methode.etapes.map((etape, i) => (
          <li class="pas" data-reveal style={`--delai: ${i * 110}ms`}>
            <span class="pas__num" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{etape.titre}</h3>
            <p>{etape.texte}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .methode__etapes {
    position: relative;
    display: grid;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pas {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 76px;
  }

  .pas__num {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
  }

  .pas:last-child .pas__num {
    background: var(--color-accent);
  }

  /* Le trait qui relie les étapes. */
  .pas:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 64px;
    bottom: -28px;
    width: 2px;
    background: repeating-linear-gradient(to bottom, var(--color-border) 0 8px, transparent 8px 14px);
  }

  .pas h3 {
    font-size: clamp(22px, 1.9vw, 27px);
    font-weight: 800;
  }

  .pas p {
    max-width: 34ch;
  }

  @media (min-width: 1000px) {
    .methode__etapes {
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
    }

    .pas {
      padding-left: 0;
      padding-top: 84px;
    }

    .pas:not(:last-child)::before {
      left: 68px;
      right: 0;
      top: 27px;
      bottom: auto;
      width: auto;
      height: 2px;
      background: repeating-linear-gradient(to right, var(--color-border) 0 8px, transparent 8px 14px);
    }
  }
</style>
