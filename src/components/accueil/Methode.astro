---
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const methode = t(langue).accueil.methode;
---

<section class="methode">
  <div class="wrap">
    <div class="methode__tete" data-reveal>
      <p class="surtitre">{methode.surtitre}</p>
      <h2>{methode.titre}</h2>
    </div>

    <!-- Une vraie liste ordonnée : les numéros sont aussi lus par les lecteurs d'écran. -->
    <ol class="methode__etapes">
      {
        methode.etapes.map((etape, i) => (
          <li data-reveal style={`--delai: ${i * 80}ms`}>
            <span class="methode__num" aria-hidden="true">0{i + 1}</span>
            <h3>{etape.titre}</h3>
            <p>{etape.texte}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .methode {
    margin-top: var(--section-gap);
  }

  .methode__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 1000px;
    margin-bottom: 56px;
  }

  .methode__etapes {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--trait) solid var(--color-ink);
  }

  .methode__etapes li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 24px 32px;
  }

  .methode__etapes li + li {
    border-top: var(--trait) solid var(--color-ink);
  }

  .methode__num {
    font-family: var(--font-title);
    font-size: clamp(72px, 8vw, 120px);
    line-height: 0.9;
    color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .methode__etapes {
      grid-template-columns: repeat(4, 1fr);
    }

    .methode__etapes li {
      padding: 36px 28px 44px;
    }

    .methode__etapes li + li {
      border-top: 0;
      border-left: var(--trait) solid var(--color-ink);
    }
  }
</style>
