---
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const methode = t(langue).accueil.methode;
---

<section class="methode">
  <div class="wrap">
    <div class="methode__tete" data-reveal>
      <p class="surtitre">{methode.surtitre}</p>
      <h2>{methode.titre}</h2>
    </div>

    <!-- Une vraie liste ordonnée : les numéros sont aussi lus par les lecteurs d'écran. -->
    <ol class="methode__etapes">
      {
        methode.etapes.map((etape, i) => (
          <li class="etape tuile-bento" data-reveal style={`--delai: ${i * 80}ms`}>
            <span class="etape__num" aria-hidden="true">{i + 1}</span>
            <h3>{etape.titre}</h3>
            <p>{etape.texte}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .methode {
    margin-top: var(--section-gap);
  }

  .methode__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 800px;
    margin-bottom: 40px;
  }

  .methode__etapes {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .etape {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
  }

  .etape__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--color-ink);
    color: #fff;
    font-size: 18px;
    font-weight: 800;
  }

  @media (min-width: 700px) {
    .methode__etapes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .methode__etapes {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
