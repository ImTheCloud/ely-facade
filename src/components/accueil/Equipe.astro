---
/**
 * Qui vient chez vous : les deux frères, détourés sur fond blanc, devant leur nom de famille écrit en très grand.
 * Sous chacun, son prénom et son rôle ; puis une phrase et deux lignes. À l'arrivée, le nom monte puis les frères
 * se posent ; tout se coupe avec « moins d'animations ».
 */
import { Image } from 'astro:assets';
import Souligne from '../Souligne.astro';
import { portraits } from '../../data/equipe';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const equipe = t(langue).accueil.equipe;
---

<section class="section equipe" id="equipe">
  <div class="wrap">
    <header class="equipe__tete" data-reveal>
      <div class="equipe__titre">
        <p class="surtitre">{equipe.surtitre}</p>
        <h2>{equipe.titre}</h2>
      </div>
      <p class="equipe__texte">{equipe.texte}</p>
    </header>

    <div class="scene" data-reveal>
      <!-- Le nom de famille, en très grand derrière les deux frères. -->
      <p class="scene__nom" aria-hidden="true">Ungureanu</p>
      <div class="scene__freres">
        {
          equipe.personnes.map((personne, i) => (
            <figure class="portrait" style={`--i: ${i}`}>
              <Image
                src={portraits.accueil[personne.prenom as 'Elisei' | 'Simi']}
                alt={`${equipe.portrait} ${personne.prenom} Ungureanu`}
                widths={[300, 500, 750]}
                sizes="(min-width: 1100px) 420px, 45vw"
                format="webp"
                quality={84}
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
      <!-- Le sol : une ligne, la brique rouge du logo en son milieu. -->
      <span class="scene__sol" aria-hidden="true"><i></i></span>
    </div>

    <div class="equipe__freres">
      {
        equipe.personnes.map((personne, i) => (
          <article class="frere" style={`--i: ${i}`} data-reveal>
            <h3 class="frere__nom">{personne.prenom}</h3>
            <p class="frere__role">{personne.role}</p>
            <p class="frere__phrase">
              <Souligne texte={personne.phrase} />
            </p>
            <p class="frere__detail">{personne.texte}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .equipe {
    background: #fff;
  }

  .equipe__tete {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(20px, 3vw, 40px);
  }

  .equipe__titre {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .equipe__titre h2 {
    max-width: 12ch;
  }

  .equipe__texte {
    max-width: 44ch;
    font-size: var(--size-lead);
    line-height: 1.55;
  }

  /* --- La scène : le nom en très grand, les deux frères posés devant, côte à côte. --- */
  .scene {
    position: relative;
    max-width: 1000px;
    margin-inline: auto;
    container-type: inline-size;
  }

  .scene__nom {
    margin: 0;
    font-family: var(--font-display);
    /* Le mot remplit toute la largeur, du téléphone à l'ordinateur. */
    font-size: 17.4cqi;
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink);
    user-select: none;
  }

  .scene__freres {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    /* Les têtes passent devant le bas du nom. */
    margin-top: -3.5cqi;
  }

  @media (min-width: 700px) {
    .scene__freres {
      gap: 2cqi;
      padding-inline: 4cqi;
    }
  }

  .portrait {
    margin: 0;
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Les deux détourages sont recadrés visage au centre, à la même taille : la paire est centrée sur la brique. */

  .scene__sol {
    position: relative;
    z-index: 2;
    display: block;
    height: 2px;
    background: var(--color-ink);
  }

  .scene__sol i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 34px;
    height: 16px;
    border: 4px solid #fff;
    border-radius: 4px;
    background: var(--color-accent);
    transform: translate(-50%, -50%);
  }

  /* --- Sous chaque frère : le prénom, le rôle, la phrase, deux lignes. --- */
  .equipe__freres {
    display: grid;
    gap: 36px;
    max-width: 1000px;
    margin: clamp(28px, 4vw, 48px) auto 0;
  }

  .frere {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .frere__nom {
    font-family: var(--font-display);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .frere__role {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .frere__role::before {
    content: '';
    width: 13px;
    height: 7px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .frere__phrase {
    max-width: 22ch;
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: var(--tracking-phrase);
    text-wrap: balance;
    color: var(--color-ink);
  }

  .frere__detail {
    max-width: 40ch;
    font-size: var(--size-body);
    line-height: 1.6;
  }

  /* Ordinateur : chaque texte sous son frère. */
  @media (min-width: 700px) {
    .equipe__tete {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: end;
      gap: 48px;
    }

    .equipe__freres {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(32px, 6vw, 96px);
    }
  }

  /* L'arrivée : le nom monte, puis les deux frères se posent, puis la brique. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .scene__nom {
      transform: translateY(30%);
      transition: transform 1000ms var(--ease-out) 100ms;
    }

    :global(.js) .portrait {
      opacity: 0;
      transform: translateY(40px);
      transition:
        opacity 900ms var(--ease-out) calc(350ms + var(--i) * 150ms),
        transform 900ms var(--ease-out) calc(350ms + var(--i) * 150ms);
    }

    :global(.js) .scene__sol i {
      transform: translate(-50%, -50%) scale(0) rotate(-20deg);
      transition: transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 1000ms;
    }

    :global(.js) .scene.est-visible .scene__nom,
    :global(.js) .scene.est-visible .portrait {
      opacity: 1;
      transform: none;
    }

    :global(.js) .scene.est-visible .scene__sol i {
      transform: translate(-50%, -50%);
    }
  }
</style>
