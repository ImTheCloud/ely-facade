---
/** Qui vient chez vous : les deux frères qui dirigent Ely Facade, et leur équipe. */
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const equipe = t(langue).accueil.equipe;
---

<section class="section equipe" id="equipe">
  <div class="wrap equipe__grille">
    <div class="equipe__texte" data-reveal>
      <p class="surtitre">{equipe.surtitre}</p>
      <h2>{equipe.titre}</h2>
      <p>{equipe.texte}</p>
    </div>

    <ul class="equipe__personnes">
      {
        equipe.personnes.map((personne, i) => (
          <li data-reveal style={`--delai: ${120 + i * 120}ms`}>
            <span class="equipe__initiale" aria-hidden="true">
              {personne.initiale}
            </span>
            <span class="equipe__nom">{personne.prenom}</span>
            <span class="equipe__role">{personne.role}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .equipe__grille {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .equipe__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .equipe__texte p:last-child {
    max-width: 50ch;
    font-size: var(--size-lead);
    line-height: 1.6;
  }

  .equipe__personnes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .equipe__personnes li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 24px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tile);
    background: var(--color-card);
    box-shadow: var(--shadow-tile);
  }

  /* Une grande initiale en filigrane, la brique rouge au-dessus du prénom. */
  .equipe__initiale {
    font-family: var(--font-display);
    font-size: clamp(88px, 11vw, 150px);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--color-surface);
    -webkit-text-stroke: 1px var(--color-border);
    margin-bottom: 18px;
  }

  .equipe__nom {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: clamp(24px, 2.2vw, 32px);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .equipe__nom::before {
    content: '';
    width: 14px;
    height: 7px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .equipe__role {
    font-size: var(--size-small);
    color: var(--color-text);
  }

  @media (min-width: 960px) {
    .equipe__grille {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 72px;
    }
  }
</style>
