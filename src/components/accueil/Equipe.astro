---
/**
 * Qui vient chez vous : les deux frères, en grand. Un portrait par frère, son prénom posé sur la photo,
 * une phrase qui dit ce qu'il fait, puis deux lignes. Les photos se dévoilent comme un rideau à l'arrivée,
 * glissent doucement au défilement (navigateurs récents) et tout se coupe avec « moins d'animations ».
 */
import { Image } from 'astro:assets';
import Souligne from '../Souligne.astro';
import { portraits } from '../../data/equipe';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const equipe = t(langue).accueil.equipe;
---

<section class="section equipe" id="equipe">
  <div class="wrap">
    <header class="equipe__tete" data-reveal>
      <div class="equipe__titre">
        <p class="surtitre">{equipe.surtitre}</p>
        <h2>{equipe.titre}</h2>
      </div>
      <p class="equipe__texte">{equipe.texte}</p>
    </header>

    <div class="equipe__duo" data-reveal>
      <!-- Le nom de famille en très grand, au trait, derrière les deux portraits : il glisse au défilement. -->
      <span class="equipe__nom-famille" aria-hidden="true">Ungureanu</span>
      <!-- Le joint entre les deux portraits, avec la brique rouge du logo : deux frères, une seule façade. -->
      <span class="equipe__joint" aria-hidden="true"><i></i></span>
      {
        equipe.personnes.map((personne, i) => (
          <article class="frere" style={`--i: ${i}`}>
            <figure class="frere__photo">
              <Image
                src={portraits.accueil[personne.prenom as 'Elisei' | 'Simi']}
                alt={`${equipe.portrait} ${personne.prenom} Ungureanu`}
                widths={[400, 640, 900]}
                sizes="(min-width: 1100px) 520px, 50vw"
                format="webp"
                quality={82}
                loading="lazy"
              />
              <h3 class="frere__nom">{personne.prenom}</h3>
            </figure>
            <div class="frere__texte">
              <p class="frere__role"><span class="frere__numero">0{i + 1}</span>{personne.role}</p>
              <p class="frere__phrase">
                <Souligne texte={personne.phrase} />
              </p>
              <p class="frere__detail">{personne.texte}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .equipe {
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface) 100%);
    overflow: hidden;
  }

  .equipe__tete {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(28px, 4vw, 56px);
  }

  .equipe__titre {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .equipe__titre h2 {
    max-width: 12ch;
  }

  .equipe__texte {
    max-width: 44ch;
    font-size: var(--size-lead);
    line-height: 1.55;
  }

  /*
   * Le diptyque : les deux portraits se touchent, comme deux panneaux d'une même façade, séparés par un joint
   * blanc et la brique rouge. Sur téléphone comme sur ordinateur, les deux frères tiennent sur le même écran.
   */
  .equipe__duo {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    row-gap: 32px;
    max-width: 1080px;
    margin-inline: auto;
  }

  .frere {
    display: contents;
  }

  .frere__photo {
    grid-row: 1;
    grid-column: calc(var(--i) + 1);
  }

  .frere__texte {
    grid-column: 1 / -1;
    grid-row: calc(var(--i) + 2);
  }

  /* Le nom de famille, géant et au trait, qui dépasse derrière les photos. */
  .equipe__nom-famille {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    grid-row: 1 / 2;
    font-family: var(--font-display);
    font-size: clamp(90px, 24vw, 300px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(31, 36, 41, 0.14);
    transform: translate(-50%, -50%);
    pointer-events: none;
    user-select: none;
  }

  .frere__photo {
    position: relative;
    z-index: 1;
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-ink);
    box-shadow: var(--shadow-lift);
    isolation: isolate;
  }

  .frere:first-child .frere__photo {
    border-radius: 22px 0 0 22px;
  }

  .frere:last-child .frere__photo {
    border-radius: 0 22px 22px 0;
  }

  .frere__photo :global(img) {
    position: absolute;
    inset: -4% 0;
    width: 100%;
    height: 108%;
    object-fit: cover;
    object-position: 50% 30%;
    transition: transform 1400ms var(--ease-out);
  }

  .frere__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(var(--voile), 0.78) 0%, rgba(var(--voile), 0.3) 26%, rgba(var(--voile), 0) 48%);
    pointer-events: none;
  }

  /* Les prénoms se font face : Elisei à gauche, Simi à droite, de part et d'autre du joint. */
  .frere__nom {
    position: absolute;
    bottom: 12px;
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(28px, 9vw, 44px);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: #fff;
  }

  .frere:first-child .frere__nom {
    left: 12px;
  }

  .frere:last-child .frere__nom {
    right: 12px;
  }

  /* Le joint : une ligne blanche entre les deux photos, la brique rouge en son milieu. */
  .equipe__joint {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 0;
    bottom: 0;
    grid-row: 1 / 2;
    width: 4px;
    margin-left: -2px;
    background: var(--color-bg);
  }

  .equipe__joint i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 16px;
    border: 3px solid var(--color-bg);
    border-radius: 4px;
    background: var(--color-accent);
    transform: translate(-50%, -50%);
  }

  .frere:hover .frere__photo :global(img) {
    transform: scale(1.04);
  }

  .frere__texte {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-inline: 6px;
  }

  .frere__role {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .frere__numero {
    padding-right: 12px;
    border-right: 1.5px solid currentColor;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-ink);
  }

  .frere__phrase {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 38px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--color-ink);
  }

  .frere__detail {
    max-width: 40ch;
    font-size: var(--size-body);
    line-height: 1.6;
  }

  @media (min-width: 700px) {
    .equipe__tete {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: end;
      gap: 48px;
    }

    .equipe__duo {
      row-gap: clamp(32px, 4vw, 52px);
    }

    /* Ordinateur : les deux textes côte à côte, chacun sous son portrait. */
    .frere__texte {
      grid-column: calc(var(--i) + 1);
      grid-row: 2;
      padding-inline: 0 clamp(20px, 4vw, 56px);
    }

    .frere:last-child .frere__texte {
      padding-inline: clamp(20px, 4vw, 56px) 0;
    }

    .frere:first-child .frere__photo {
      border-radius: 32px 0 0 32px;
    }

    .frere:last-child .frere__photo {
      border-radius: 0 32px 32px 0;
    }

    .frere__nom {
      bottom: clamp(14px, 2.4vw, 28px);
      font-size: clamp(54px, 8vw, 96px);
    }

    .frere:first-child .frere__nom {
      left: clamp(18px, 3vw, 34px);
    }

    .frere:last-child .frere__nom {
      right: clamp(18px, 3vw, 34px);
    }

    .equipe__joint {
      width: 6px;
      margin-left: -3px;
    }

    .equipe__joint i {
      width: 46px;
      height: 24px;
      border-width: 4px;
      border-radius: 5px;
    }
  }

  /*
   * L'arrivée : les deux portraits s'ouvrent depuis le joint, comme deux volets, puis la brique se pose.
   * Seulement avec JavaScript et sans « moins d'animations ».
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .equipe__duo .frere__photo {
      transition: clip-path 1100ms var(--ease-out) calc(var(--i) * 120ms);
    }

    :global(.js) .equipe__duo .frere:first-child .frere__photo {
      clip-path: inset(0 0 0 100%);
    }

    :global(.js) .equipe__duo .frere:last-child .frere__photo {
      clip-path: inset(0 100% 0 0);
    }

    :global(.js) .equipe__duo.est-visible .frere .frere__photo {
      clip-path: inset(0 0 0 0);
    }

    :global(.js) .equipe__duo .equipe__joint i {
      transform: translate(-50%, -50%) scale(0) rotate(-20deg);
      transition: transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 900ms;
    }

    :global(.js) .equipe__duo.est-visible .equipe__joint i {
      transform: translate(-50%, -50%);
    }

    :global(.js) .equipe__duo .frere__texte {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 700ms var(--ease-out) calc(700ms + var(--i) * 150ms),
        transform 700ms var(--ease-out) calc(700ms + var(--i) * 150ms);
    }

    :global(.js) .equipe__duo.est-visible .frere__texte {
      opacity: 1;
      transform: none;
    }

    /* Au défilement (navigateurs récents) : les photos glissent plus lentement que la page, le nom de famille passe. */
    @supports (animation-timeline: view()) {
      .frere__photo :global(img) {
        animation: frere-glisse linear both;
        animation-timeline: view();
      }

      .equipe__nom-famille {
        animation: nom-passe linear both;
        animation-timeline: view();
      }

      @keyframes frere-glisse {
        from {
          transform: translateY(-3.5%);
        }
        to {
          transform: translateY(3.5%);
        }
      }

      @keyframes nom-passe {
        from {
          transform: translate(-38%, -50%);
        }
        to {
          transform: translate(-62%, -50%);
        }
      }
    }
  }
</style>
