---
/**
 * Qui vient chez vous : les deux frères, détourés sur fond blanc, devant « ELY FACADE » écrit en très grand.
 * Ordinateur : chaque frère a son repère sur le côté, comme une annotation sur un plan de façade (prénom, rôle,
 * une phrase), relié à lui par un trait. Téléphone : les repères passent sous la photo, côte à côte.
 * La scène ne bouge pas.
 */
import { Image } from 'astro:assets';
import { portraits } from '../../data/equipe';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const equipe = t(langue).accueil.equipe;
---

<section class="section equipe" id="equipe">
  <div class="wrap">
    <h2 class="equipe__titre" data-reveal>{equipe.titre}</h2>

    <div class="scene">
      <!-- Le nom de l'entreprise, en très grand derrière les deux frères. -->
      <p class="scene__nom" aria-hidden="true">Ely <span>Facade</span></p>
      <div class="scene__freres">
        {
          equipe.personnes.map((personne) => (
            <figure class="portrait">
              <Image
                src={portraits.accueil[personne.prenom as 'Elisei' | 'Simi']}
                alt={`${equipe.portrait} ${personne.prenom} Ungureanu`}
                widths={[300, 500, 750]}
                sizes="(min-width: 1000px) 400px, 50vw"
                format="webp"
                quality={84}
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
      <!-- Le sol : une ligne, la brique rouge du logo en son milieu. -->
      <span class="scene__sol" aria-hidden="true"><i></i></span>

      <div class="reperes">
        {
          equipe.personnes.map((personne, i) => (
            <article class:list={['repere', i === 0 ? 'repere--gauche' : 'repere--droite']}>
              <h3 class="repere__nom">{personne.prenom}</h3>
              <p class="repere__role">
                <span class="repere__role-long">{personne.role}</span>
                <span class="repere__role-court">{personne.roleCourt}</span>
              </p>
              <p class="repere__texte">{personne.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .equipe {
    background: #fff;
  }

  /* Le titre tient sur une seule ligne, du téléphone à l'ordinateur. */
  .equipe__titre {
    margin-bottom: clamp(20px, 3vw, 40px);
    text-align: center;
    font-size: min(var(--size-h2), 5.6vw);
    white-space: nowrap;
  }

  /* --- La scène : le nom en très grand, les deux frères posés devant. --- */
  .scene {
    position: relative;
    container-type: inline-size;
  }

  .scene__nom {
    margin: 0;
    font-family: var(--font-display);
    /* « ELY FACADE » remplit toute la largeur, du téléphone à l'ordinateur. */
    font-size: 15.2cqi;
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink);
    user-select: none;
  }

  .scene__nom span {
    color: var(--color-accent);
  }

  .scene__freres {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    /* Les têtes passent devant le bas du nom. */
    margin-top: -2cqi;
    padding-inline: 1cqi 0;
  }

  .portrait {
    margin: 0;
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* La photo de Simi a plus d'épaule à droite : il se rapproche de son frère pour que la paire soit centrée. */
  .portrait:last-child {
    transform: translateX(-4%);
  }

  .scene__sol {
    position: relative;
    z-index: 2;
    display: block;
    height: 2px;
    margin-top: 2cqi;
    background: var(--color-ink);
  }

  .scene__sol i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 34px;
    height: 16px;
    border: 4px solid #fff;
    border-radius: 4px;
    background: var(--color-accent);
    transform: translate(-50%, -50%);
  }

  /* --- Les repères : prénom, rôle, une phrase. Téléphone : sous la photo, côte à côte. --- */
  .reperes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 28px;
  }

  .repere {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /*
   * Téléphone : chaque repère centré sous son frère, relié à la ligne du sol par un trait vertical
   * qui part d'un point rouge, comme les repères de l'ordinateur.
   */
  @media (max-width: 999px) {
    .reperes {
      margin-top: 40px;
    }

    .repere {
      align-items: center;
      text-align: center;
    }

    .repere::before {
      content: '';
      position: absolute;
      bottom: calc(100% + 6px);
      left: 50%;
      width: 1.5px;
      height: 30px;
      background: var(--color-ink);
    }

    .repere::after {
      content: '';
      position: absolute;
      bottom: calc(100% + 32px);
      left: 50%;
      width: 9px;
      height: 9px;
      margin-left: -3.75px;
      border-radius: 50%;
      background: var(--color-accent);
    }
  }

  .repere__nom {
    font-family: var(--font-display);
    font-size: clamp(30px, 4.6vw, 60px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .repere__role {
    font-size: clamp(14px, 4.2vw, 16px);
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--color-accent);
  }

  .repere__role-long {
    display: none;
  }

  .repere__texte {
    max-width: 30ch;
    font-size: clamp(14.5px, 1.25vw, 17px);
    line-height: 1.5;
    color: var(--color-ink);
  }

  /*
   * Ordinateur : les frères au centre, un repère de chaque côté à hauteur d'épaule,
   * relié à eux par un trait fin qui finit par un point, comme une cote sur un plan.
   */
  @media (min-width: 1000px) {
    .scene__freres {
      padding-inline: 22cqi 20cqi;
    }

    .reperes {
      position: absolute;
      inset: 0;
      z-index: 3;
      display: block;
      margin: 0;
      pointer-events: none;
    }

    .repere {
      position: absolute;
      top: 48%;
      width: 19.5cqi;
      pointer-events: auto;
    }

    .repere--gauche {
      left: 0;
      align-items: flex-end;
      text-align: right;
    }

    .repere--droite {
      right: 0;
    }

    .repere__role {
      font-size: 13px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      white-space: normal;
    }

    .repere__role-long {
      display: inline;
    }

    .repere__role-court {
      display: none;
    }

    /* Le trait, à hauteur du prénom, vers le frère. */
    .repere::before,
    .repere::after {
      content: '';
      position: absolute;
      top: 0.42em;
      font-size: clamp(30px, 4.6vw, 60px);
    }

    .repere::before {
      width: 3cqi;
      height: 1.5px;
      background: var(--color-ink);
    }

    .repere::after {
      width: 9px;
      height: 9px;
      margin-top: -4px;
      border-radius: 50%;
      background: var(--color-accent);
    }

    .repere--gauche::before {
      left: calc(100% + 1.5cqi);
    }

    .repere--gauche::after {
      left: calc(100% + 4.5cqi);
    }

    .repere--droite::before {
      right: calc(100% + 1.5cqi);
    }

    .repere--droite::after {
      right: calc(100% + 4.5cqi);
    }
  }
</style>
