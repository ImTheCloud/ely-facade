---
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const equipe = t(langue).accueil.equipe;
---

<section class="equipe">
  <div class="wrap equipe__grille" data-reveal>
    <div class="equipe__titre">
      <p class="surtitre">{equipe.surtitre}</p>
      <h2>{equipe.titre}</h2>
    </div>
    <p class="equipe__texte">{equipe.texte}</p>
  </div>
</section>

<style>
  .equipe {
    margin-top: var(--section-gap);
    padding-block: 64px;
    background: var(--color-accent);
    color: #fff;
  }

  .equipe :global(h2),
  .equipe :global(.surtitre) {
    color: #fff;
  }

  .equipe :global(.surtitre)::before {
    background: #fff;
  }

  .equipe__grille {
    display: grid;
    gap: 32px;
    align-items: end;
  }

  .equipe__titre {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .equipe__texte {
    max-width: 52ch;
    font-size: var(--size-lead);
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .equipe {
      padding-block: 112px;
    }

    .equipe__grille {
      grid-template-columns: 1.2fr 1fr;
      gap: 72px;
    }
  }
</style>
