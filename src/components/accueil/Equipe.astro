---
/**
 * Qui vient chez vous : les deux frères, détourés sur fond blanc, devant leur nom de famille écrit en très grand.
 * Sous chacun, son prénom et son rôle ; puis une phrase et deux lignes. La scène ne bouge pas : les frères sont là,
 * tout simplement.
 */
import { Image } from 'astro:assets';
import Souligne from '../Souligne.astro';
import { portraits } from '../../data/equipe';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const equipe = t(langue).accueil.equipe;
---

<section class="section equipe" id="equipe">
  <div class="wrap">
    <header class="equipe__tete" data-reveal>
      <div class="equipe__titre">
        <p class="surtitre">{equipe.surtitre}</p>
        <h2>{equipe.titre}</h2>
      </div>
      <p class="equipe__texte">{equipe.texte}</p>
    </header>

    <div class="scene">
      <!-- Le nom de famille, en très grand derrière les deux frères. -->
      <p class="scene__nom" aria-hidden="true">Ungureanu</p>
      <div class="scene__freres">
        {
          equipe.personnes.map((personne, i) => (
            <figure class="portrait" style={`--i: ${i}`}>
              <Image
                src={portraits.accueil[personne.prenom as 'Elisei' | 'Simi']}
                alt={`${equipe.portrait} ${personne.prenom} Ungureanu`}
                widths={[300, 500, 750]}
                sizes="(min-width: 1100px) 420px, 45vw"
                format="webp"
                quality={84}
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
      <!-- Le sol : une ligne, la brique rouge du logo en son milieu. -->
      <span class="scene__sol" aria-hidden="true"><i></i></span>
    </div>

    <div class="equipe__freres">
      {
        equipe.personnes.map((personne, i) => (
          <article class="frere" style={`--i: ${i}`} data-reveal>
            <h3 class="frere__nom">{personne.prenom}</h3>
            <p class="frere__role">{personne.role}</p>
            <p class="frere__phrase">
              <Souligne texte={personne.phrase} />
            </p>
            <p class="frere__detail">{personne.texte}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .equipe {
    background: #fff;
  }

  .equipe__tete {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(20px, 3vw, 40px);
  }

  .equipe__titre {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .equipe__titre h2 {
    max-width: 12ch;
  }

  .equipe__texte {
    max-width: 44ch;
    font-size: var(--size-lead);
    line-height: 1.55;
  }

  /* --- La scène : le nom en très grand, les deux frères posés devant, côte à côte. --- */
  .scene {
    position: relative;
    max-width: 1000px;
    margin-inline: auto;
    container-type: inline-size;
  }

  .scene__nom {
    margin: 0;
    font-family: var(--font-display);
    /* Le mot remplit toute la largeur, du téléphone à l'ordinateur. */
    font-size: 17.4cqi;
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink);
    user-select: none;
  }

  .scene__freres {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    /* Les têtes passent devant le bas du nom. */
    margin-top: -1cqi;
    /* La paire est légèrement poussée vers la droite pour tomber au centre de la ligne. */
    padding-inline: 1cqi 0;
  }

  /* Ordinateur : un peu moins grands, toujours au centre. */
  @media (min-width: 700px) {
    .scene__freres {
      padding-inline: 9cqi 7cqi;
    }
  }

  .portrait {
    margin: 0;
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* La photo de Simi a plus d'épaule à droite : il se rapproche de son frère pour que la paire soit centrée. */
  .portrait:last-child {
    transform: translateX(-4%);
  }

  .scene__sol {
    position: relative;
    z-index: 2;
    display: block;
    /* La ligne passe juste sous eux, un peu plus bas que le bas des photos. */
    margin-top: 2cqi;
    height: 2px;
    background: var(--color-ink);
  }

  .scene__sol i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 34px;
    height: 16px;
    border: 4px solid #fff;
    border-radius: 4px;
    background: var(--color-accent);
    transform: translate(-50%, -50%);
  }

  /* --- Sous chaque frère : le prénom, le rôle, la phrase, deux lignes. --- */
  /* Chacun son texte sous lui, côte à côte, sur téléphone comme sur ordinateur. */
  .equipe__freres {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    max-width: 1000px;
    margin: clamp(28px, 4vw, 48px) auto 0;
  }

  .frere {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .frere__nom {
    font-family: var(--font-display);
    font-size: clamp(30px, 6vw, 72px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .frere__role {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: clamp(11px, 1.2vw, 13px);
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .frere__role::before {
    content: '';
    flex-shrink: 0;
    width: 13px;
    height: 7px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .frere__phrase {
    max-width: 22ch;
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 32px);
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: var(--tracking-phrase);
    text-wrap: balance;
    color: var(--color-ink);
  }

  .frere__detail {
    max-width: 40ch;
    font-size: clamp(14px, 1.3vw, 17px);
    line-height: 1.55;
  }

  /*
   * Téléphone (deux colonnes étroites) : le rôle tient sur une ligne, écrit simplement ;
   * le texte gris n'est pas affiché, le rôle et la phrase disent déjà l'essentiel.
   */
  @media (max-width: 699px) {
    .frere {
      gap: 8px;
    }

    .frere__role {
      font-size: clamp(10.5px, 3.45vw, 12.5px);
      font-weight: 650;
      letter-spacing: 0;
      text-transform: none;
      white-space: nowrap;
    }

    .frere__role::before {
      display: none;
    }

    .frere__phrase {
      margin-top: 2px;
    }

    .frere__detail {
      display: none;
    }
  }

  /* Ordinateur : chaque texte sous son frère. */
  @media (min-width: 700px) {
    .equipe__tete {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: end;
      gap: 48px;
    }

    .equipe__freres {
      gap: clamp(32px, 6vw, 96px);
    }
  }
</style>
