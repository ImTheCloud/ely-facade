---
/**
 * « Les étapes d'une façade » : le chantier de l'immeuble de quatre étages de l'Université de Mons, en 4 étapes.
 * On choisit l'étape avec les pastilles numérotées (ou « Étape suivante ») : la photo et le texte changent,
 * rien ne bouge au défilement. Sans JavaScript, les quatre étapes s'affichent l'une sous l'autre.
 * L'ordre des étapes est celui confirmé par Elisei ; les légendes ne disent que ce qu'on voit.
 */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Souligne from '../Souligne.astro';
import { ETAPES_FACADE, photo } from '../../data/chantiers';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const section = textes.accueil.etapes;

const etapes = ETAPES_FACADE.map((etape, i) => ({
  ...etape,
  numero: i + 1,
  texte: section.liste[etape.cle],
  plans: etape.photos.map((chemin, j) => ({ chemin, legende: section.liste[etape.cle].legendes[j] })),
}));
const image = { widths: [480, 768, 1080, 1440], sizes: '(min-width: 900px) 52vw, 100vw', format: 'webp' as const, quality: 74 };
---

<section class="section etapes" id="etapes" data-etapes>
  <div class="wrap">
    <div class="tete" data-reveal>
      <p class="surtitre">{section.pastille}</p>
      <h2 data-trait><Souligne texte={section.titre} /></h2>
      <p>{section.texte}</p>
    </div>

    <div class="etapes__corps" data-reveal>
      <!-- Les pastilles : seulement avec JavaScript. -->
      <div class="etapes__onglets" role="tablist" aria-label={section.pastille}>
        {
          etapes.map((etape, i) => (
            <button
              type="button"
              role="tab"
              id={`etape-onglet-${etape.numero}`}
              aria-controls={`etape-${etape.numero}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class:list={['onglet', { 'est-actif': i === 0 }]}
              data-onglet
            >
              <span class="onglet__num">{etape.numero}</span>
              <span class="onglet__titre">{etape.texte.titre}</span>
            </button>
          ))
        }
      </div>

      <div class="etapes__liste">
        {
          etapes.map((etape, i) => (
            <div
              class:list={['etape', { 'est-actif': i === 0 }]}
              id={`etape-${etape.numero}`}
              role="tabpanel"
              aria-labelledby={`etape-onglet-${etape.numero}`}
              data-etape
            >
              <div class:list={['etape__photos', `etape__photos--${etape.plans.length}`]}>
                {etape.plans.map((plan) => (
                  <figure>
                    <Image src={photo(plan.chemin)} alt={textes.photos[plan.chemin]} loading={i === 0 ? 'eager' : 'lazy'} {...image} />
                    <figcaption>{plan.legende}</figcaption>
                  </figure>
                ))}
              </div>

              <div class="etape__texte">
                <span class="etape__num">
                  {section.etape} {etape.numero} / {etapes.length}
                </span>
                <h3 id={`etape-titre-${etape.numero}`}>{etape.texte.titre}</h3>
                <p>{etape.texte.texte}</p>
                <p class="etape__lieu">{section.lieu}</p>
                {i < etapes.length - 1 && (
                  <button type="button" class="etape__suivante" data-suivante>
                    {section.suivante}
                    <Icon nom="fleche" taille={18} />
                  </button>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import '~/scripts/etapes';
</script>

<style>
  .etapes__onglets {
    display: none;
  }

  .etapes__liste {
    display: grid;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .etape {
    display: grid;
    gap: 20px;
  }

  /* --- Photos : un cadre de taille fixe, une ou deux photos --- */
  .etape__photos {
    display: grid;
    gap: 6px;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: var(--radius-tile);
    background: var(--color-surface);
    box-shadow: var(--shadow-lift);
  }

  .etape__photos--2 {
    grid-template-columns: 1fr 1fr;
  }

  .etape__photos figure {
    position: relative;
    margin: 0;
    min-height: 0;
    overflow: hidden;
  }

  .etape__photos :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .etape__photos figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    max-width: calc(100% - 24px);
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 12.5px;
    font-weight: 650;
    line-height: 1.25;
    color: var(--color-ink);
  }

  /* --- Texte --- */
  .etape__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .etape__num {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .etape__num::before {
    content: '';
    width: 13px;
    height: 7px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .etape h3 {
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .etape__texte p {
    max-width: 44ch;
    font-size: var(--size-lead);
    line-height: 1.55;
  }

  .etape__texte .etape__lieu {
    font-size: var(--size-tiny);
    color: var(--color-muted);
  }

  .etape__suivante {
    display: none;
  }

  /* ---------------------------------------------------------------------
     Avec JavaScript : une étape à la fois, choisie avec les pastilles.
     --------------------------------------------------------------------- */
  :global(.js) .etapes__onglets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 24px;
  }

  :global(.js) .etape:not(.est-actif) {
    display: none;
  }

  :global(.js) .etape__suivante {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    margin-top: 6px;
    padding: 0 22px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: #fff;
    font: 650 15px/1 var(--font-text);
    cursor: pointer;
    transition: background-color var(--speed) var(--ease);
  }

  :global(.js) .etape__suivante:hover {
    background: #343b42;
  }

  :global(.js) .etape__suivante:focus-visible,
  .onglet:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Pastille d'étape : sur téléphone, le numéro seulement ; sur grand écran, le numéro et le titre. */
  .onglet {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-height: 56px;
    padding: 10px 4px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-card);
    color: var(--color-muted);
    font-family: inherit;
    text-align: center;
    cursor: pointer;
    transition:
      background-color var(--speed) var(--ease),
      color var(--speed) var(--ease),
      border-color var(--speed) var(--ease);
  }

  .onglet__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-surface);
    font-size: 15px;
    font-weight: 750;
    color: var(--color-ink);
    transition:
      background-color var(--speed) var(--ease),
      color var(--speed) var(--ease);
  }

  .onglet__titre {
    display: none;
    font-size: 15px;
    font-weight: 650;
    line-height: 1.25;
  }

  .onglet:hover {
    border-color: var(--color-ink);
  }

  .onglet.est-actif {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }

  .onglet.est-actif .onglet__num {
    background: var(--color-accent);
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .etape.est-actif {
      animation: etape-entre 520ms var(--ease-out) both;
    }

    @keyframes etape-entre {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
    }
  }

  @media (min-width: 900px) {
    .etape {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 56px;
      align-items: center;
    }

    .etapes__liste {
      gap: 64px;
    }

    .onglet {
      flex-direction: row;
      align-items: center;
      gap: 14px;
      padding: 12px 16px;
      text-align: left;
    }

    .onglet__titre {
      display: block;
    }
  }
</style>
