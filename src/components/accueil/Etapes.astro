---
import { Image } from 'astro:assets';
import { etapes as photos, type CleEtape } from '../../data/chantiers';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const etapes = t(langue).accueil.etapes;
---

<section class="etapes" id="etapes">
  <div class="wrap">
    <div class="etapes__tete" data-reveal>
      <p class="surtitre">{etapes.surtitre}</p>
      <h2>{etapes.titre}</h2>
      <p class="etapes__texte">{etapes.texte}</p>
    </div>

    <ol class="etapes__liste">
      {
        etapes.liste.map((etape, i) => (
          <li class="etape" data-reveal>
            <div class="etape__texte">
              <span class="etape__numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{etape.titre}</h3>
              <p>{etape.texte}</p>
            </div>
            <div class="etape__photo tuile-bento">
              <Image
                src={photos[etape.cle as CleEtape]}
                alt={etape.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1100px) 720px, 100vw"
                format="webp"
                loading="lazy"
              />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .etapes {
    margin-top: var(--section-gap);
  }

  .etapes__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 760px;
    margin-bottom: 48px;
  }

  .etapes__texte {
    font-size: var(--size-lead);
  }

  .etapes__liste {
    display: grid;
    gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .etape {
    display: grid;
    gap: 20px;
  }

  .etape__texte {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 44ch;
  }

  .etape__numero {
    font-size: var(--size-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .etape__photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  .etape__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .etapes__liste {
      gap: 24px;
    }

    .etape {
      grid-template-columns: 5fr 7fr;
      align-items: center;
      gap: 56px;
      padding: 24px 0;
      border-top: 1px solid var(--color-border);
    }

    /* Une étape sur deux : la photo passe à gauche. */
    .etape:nth-child(even) {
      grid-template-columns: 7fr 5fr;
    }

    .etape:nth-child(even) .etape__photo {
      order: -1;
    }

    .etape__texte {
      padding-inline: 16px;
    }

    .etape__photo {
      aspect-ratio: 16 / 10;
    }
  }
</style>
