---
/** Toutes les photos de chantier : filtre par commune, agrandissement au clic (voir scripts/galerie.ts). */
import { getImage, Image } from 'astro:assets';
import { galerie } from '../../data/chantiers';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue).accueil.galerie;
const alts = textes.photos as Record<string, string>;
const communes = Object.keys(textes.communes) as (keyof typeof textes.communes)[];

const photos = await Promise.all(
  galerie.map(async (photo) => ({
    ...photo,
    alt: alts[photo.nom],
    grande: (await getImage({ src: photo.image, width: 1600, format: 'webp' })).src,
  })),
);
---

<section class="galerie" id="chantiers" data-galerie>
  <div class="wrap">
    <div class="galerie__tete" data-reveal>
      <div class="galerie__titre">
        <p class="surtitre">{textes.surtitre}</p>
        <h2>{textes.titre}</h2>
        <p class="galerie__texte">{textes.texte}</p>
      </div>
      <div class="galerie__filtres" role="group" aria-label={textes.filtreAria} data-filtres>
        <button type="button" aria-pressed="true" data-commune="">{textes.tous} ({photos.length})</button>
        {communes.map((c) => <button type="button" aria-pressed="false" data-commune={c}>{textes.communes[c]}</button>)}
      </div>
    </div>

    <ul class="galerie__grille">
      {
        photos.map((photo) => (
          <li class="galerie__item" data-commune={photo.commune}>
            <a href={photo.grande} data-photo data-alt={photo.alt} aria-label={`${textes.agrandir} : ${photo.alt}`}>
              <Image
                src={photo.image}
                alt={photo.alt}
                widths={[360, 560, 800]}
                sizes="(min-width: 1200px) 25vw, (min-width: 760px) 33vw, 50vw"
                format="webp"
                loading="lazy"
              />
              <span>{textes.communes[photo.commune]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="visionneuse" aria-label={textes.lightboxAria} data-visionneuse>
    <div class="visionneuse__cadre">
      <button type="button" class="visionneuse__bouton visionneuse__fermer" aria-label={textes.fermer} data-fermer>✕</button>
      <button type="button" class="visionneuse__bouton visionneuse__prec" aria-label={textes.precedente} data-precedente>‹</button>
      <button type="button" class="visionneuse__bouton visionneuse__suiv" aria-label={textes.suivante} data-suivante>›</button>
      <img alt="" data-grande />
      <p data-legende></p>
    </div>
  </dialog>
</section>

<script>
  import '~/scripts/galerie';
</script>

<style>
  .galerie {
    margin-top: var(--section-gap);
  }

  .galerie__tete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .galerie__titre {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 760px;
  }

  .galerie__texte {
    max-width: 52ch;
    font-size: var(--size-lead);
    line-height: 1.55;
  }

  .galerie__filtres {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .galerie__filtres button {
    min-height: var(--tap-min);
    padding: 0 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-card);
    font: inherit;
    font-size: var(--size-small);
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
  }

  .galerie__filtres button[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
  }

  .galerie__filtres button:focus-visible,
  .galerie__item a:focus-visible,
  .visionneuse__bouton:focus-visible {
    outline: 3px solid var(--color-ink);
    outline-offset: 3px;
  }

  .galerie__grille {
    columns: 2;
    column-gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .galerie__item {
    margin: 0 0 12px;
    break-inside: avoid;
  }

  .galerie__item[hidden] {
    display: none;
  }

  .galerie__item a {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow: var(--shadow-tile);
    cursor: zoom-in;
  }

  .galerie__item img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 600ms var(--ease-out);
  }

  .galerie__item a:hover img {
    transform: scale(1.04);
  }

  .galerie__item span {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.92);
    font-size: var(--size-tiny);
    font-weight: 700;
    color: var(--color-ink);
  }

  .visionneuse {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .visionneuse::backdrop {
    background: rgba(12, 14, 16, 0.93);
  }

  .visionneuse__cadre {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 64px 16px 72px;
  }

  .visionneuse img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    border-radius: 12px;
  }

  .visionneuse p {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    padding: 0 72px;
    text-align: center;
    font-size: var(--size-small);
    color: #fff;
  }

  .visionneuse__bouton {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    font-size: 22px;
    color: #fff;
    cursor: pointer;
  }

  .visionneuse__fermer {
    top: 12px;
    right: 12px;
  }

  .visionneuse__prec,
  .visionneuse__suiv {
    top: 50%;
    transform: translateY(-50%);
  }

  .visionneuse__prec {
    left: 10px;
  }

  .visionneuse__suiv {
    right: 10px;
  }

  @media (min-width: 760px) {
    .galerie__grille {
      columns: 3;
      column-gap: 16px;
    }

    .galerie__item {
      margin-bottom: 16px;
    }
  }

  @media (min-width: 1200px) {
    .galerie__grille {
      columns: 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .galerie__item img {
      transition: none;
    }
  }
</style>
