---
import Comparateur from '../Comparateur.astro';
import { paires, type ClePaire } from '../../data/chantiers';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const comparaisons = t(langue).accueil.comparaisons;
---

<section class="comparaisons" id="avant-apres">
  <div class="wrap">
    <div class="comparaisons__tete" data-reveal>
      <p class="surtitre">{comparaisons.surtitre}</p>
      <h2>{comparaisons.titre}</h2>
      <p class="comparaisons__texte">{comparaisons.texte}</p>
    </div>

    <div class="comparaisons__liste">
      {
        comparaisons.liste.map((item) => (
          <figure class="comparaison" data-reveal style={`--ratio: ${paires[item.cle as ClePaire].avant.width / paires[item.cle as ClePaire].avant.height}`}>
            <Comparateur
              class="comparaison__curseur tuile-bento"
              langue={langue}
              avant={paires[item.cle as ClePaire].avant}
              apres={paires[item.cle as ClePaire].apres}
              altAvant={item.altAvant}
              altApres={item.altApres}
              sizes="(min-width: 1100px) 1280px, 100vw"
            />
            <figcaption class="comparaison__legende">
              <strong>{item.commune}</strong>
              <span>{item.legende}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .comparaisons {
    margin-top: var(--section-gap);
  }

  .comparaisons__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 760px;
    margin-bottom: 40px;
  }

  .comparaisons__texte {
    font-size: var(--size-lead);
  }

  .comparaisons__liste {
    display: grid;
    gap: 40px;
  }

  .comparaison {
    margin: 0;
  }

  .comparaison :global(.comparaison__curseur) {
    aspect-ratio: 5 / 4;
  }

  .comparaison__legende {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 16px 4px 0;
    font-size: var(--size-small);
    color: var(--color-text);
  }

  .comparaison__legende strong {
    font-size: var(--size-body);
    color: var(--color-ink);
  }

  @media (min-width: 700px) {
    .comparaison :global(.comparaison__curseur) {
      aspect-ratio: min(var(--ratio), 2.2);
    }
  }

  @media (min-width: 1100px) {
    .comparaisons__liste {
      gap: 56px;
    }

    .comparaison :global(.comparaison__curseur) {
      aspect-ratio: var(--ratio);
    }
  }
</style>
