---
import Comparateur from '../Comparateur.astro';
import { paires, type ClePaire } from '../../data/chantiers';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const comparaisons = t(langue).accueil.comparaisons;
---

<section class="comparaisons" id="avant-apres" data-avant-apres>
  <div class="wrap">
    <div class="comparaisons__tete" data-reveal>
      <p class="surtitre">{comparaisons.surtitre}</p>
      <h2>{comparaisons.titre}</h2>
      <p class="comparaisons__texte">{comparaisons.texte}</p>
    </div>

    <div class="comparaisons__onglets" role="tablist" aria-label={comparaisons.ongletsAria} data-onglets>
      {
        comparaisons.liste.map((item, i) => (
          <button type="button" role="tab" id={`onglet-${item.cle}`} aria-controls={`panneau-${item.cle}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <strong>{item.commune}</strong>
            <span>{item.legende}</span>
          </button>
        ))
      }
    </div>

    <div class="comparaisons__liste">
      {
        comparaisons.liste.map((item, i) => {
          const paire = paires[item.cle as ClePaire];
          return (
            <figure class="comparaison" role="tabpanel" id={`panneau-${item.cle}`} aria-labelledby={`onglet-${item.cle}`} hidden={i !== 0} style={`--ratio: ${paire.avant.width / paire.avant.height}`}>
              <Comparateur
                class="comparaison__curseur tuile-bento"
                langue={langue}
                avant={paire.avant}
                apres={paire.apres}
                altAvant={item.altAvant}
                altApres={item.altApres}
                sizes="(min-width: 1100px) 1280px, 100vw"
              />
            </figure>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import '~/scripts/avant-apres';
</script>

<style>
  .comparaisons {
    margin-top: var(--section-gap);
  }

  .comparaisons__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 760px;
    margin-bottom: 40px;
  }

  .comparaisons__texte {
    font-size: var(--size-lead);
  }

  .comparaison {
    margin: 0;
  }

  .comparaison :global(.comparaison__curseur) {
    aspect-ratio: 5 / 4;
  }

  .comparaisons__onglets {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    padding-bottom: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .comparaisons__onglets::-webkit-scrollbar {
    display: none;
  }

  .comparaisons__onglets button {
    flex: 0 0 auto;
    display: grid;
    gap: 2px;
    min-height: var(--tap-min);
    padding: 10px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-card);
    font: inherit;
    text-align: left;
    color: var(--color-text);
    cursor: pointer;
  }

  .comparaisons__onglets button strong {
    font-size: var(--size-small);
    color: var(--color-ink);
  }

  .comparaisons__onglets button span {
    font-size: var(--size-tiny);
  }

  .comparaisons__onglets button[aria-selected='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: rgba(255, 255, 255, 0.78);
  }

  .comparaisons__onglets button[aria-selected='true'] strong {
    color: #fff;
  }

  .comparaisons__onglets button:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (min-width: 700px) {
    .comparaison :global(.comparaison__curseur) {
      aspect-ratio: min(var(--ratio), 2.2);
    }
  }

  @media (min-width: 1100px) {
    .comparaison :global(.comparaison__curseur) {
      aspect-ratio: var(--ratio);
    }
  }
</style>
