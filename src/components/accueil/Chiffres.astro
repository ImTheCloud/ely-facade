---
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const chiffres = t(langue).accueil.chiffres;
---

<ul class="chiffres" aria-label={chiffres.aria}>
  {
    chiffres.liste.map((chiffre, i) => (
      <li class:list={['chiffre', { 'chiffre--rouge': i === 2 }]} data-fenetre>
        <span class="chiffre__valeur">{chiffre.valeur}</span>
        <span class="chiffre__libelle">{chiffre.libelle}</span>
      </li>
    ))
  }
</ul>

<script>
  // Le reflet de la vitre suit le doigt ou la souris.
  document.querySelectorAll<HTMLElement>('[data-fenetre]').forEach((fenetre) => {
    fenetre.addEventListener('pointermove', (e) => {
      const r = fenetre.getBoundingClientRect();
      fenetre.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      fenetre.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  });
</script>

<style>
  .chiffres {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Une fenêtre : fin cadre graphite comme les menuiseries des façades, vitre claire avec un reflet. */
  .chiffre {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 150px;
    padding: 22px;
    overflow: hidden;
    border: 3px solid #2b3239;
    border-radius: 20px;
    background:
      radial-gradient(circle 180px at var(--mx, 85%) var(--my, 0%), rgba(255, 255, 255, 0.9), transparent 70%),
      linear-gradient(160deg, #f6f9fb 0%, #e6edf2 100%);
    box-shadow: var(--shadow-tile);
    transition:
      transform var(--speed) var(--ease),
      box-shadow var(--speed) var(--ease);
  }

  .chiffre:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }

  .chiffre__valeur {
    font-size: clamp(38px, 4.4vw, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-ink);
  }

  .chiffre__libelle {
    font-size: var(--size-small);
    font-weight: 550;
    line-height: 1.35;
    color: var(--color-text);
  }

  /* La garantie : la seule tuile teintée de rouge. */
  .chiffre--rouge {
    background:
      radial-gradient(circle 180px at var(--mx, 85%) var(--my, 0%), rgba(255, 255, 255, 0.85), transparent 70%),
      linear-gradient(160deg, #fff4f4 0%, #fbe3e4 100%);
  }

  .chiffre--rouge .chiffre__valeur {
    color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .chiffre {
      min-height: 0;
      padding: 28px;
    }
  }
</style>
