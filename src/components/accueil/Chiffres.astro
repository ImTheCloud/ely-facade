---
/** La bande des chiffres, juste sous la phrase d'ouverture. Seulement des chiffres confirmés ; « {n} » est le vrai nombre de services (src/data/metiers.ts). */
import { METIERS } from '../../data/metiers';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const chiffres = t(langue).accueil.chiffres;
---

<section class="chiffres-section" aria-label={chiffres.aria}>
  <ul class="wrap chiffres">
    {
      chiffres.liste.map((chiffre, i) => (
        <li class:list={['chiffre', { 'chiffre--rouge': i === 6 }]} data-reveal style={`--delai: ${i * 90}ms`}>
          <span class="chiffre__valeur">{chiffre.valeur.replace('{n}', String(METIERS.length))}</span>
          <span class="chiffre__libelle">{chiffre.libelle}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .chiffres-section {
    padding-block: clamp(20px, 3vw, 36px) clamp(36px, 5vw, 64px);
    border-bottom: 1px solid var(--color-border);
  }

  .chiffres {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 16px;
    margin-block: 0;
    list-style: none;
  }

  .chiffre {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 18px;
    border-left: 2px solid var(--color-border);
  }

  .chiffre__valeur {
    font-family: var(--font-display);
    font-size: clamp(30px, 9.4vw, 44px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .chiffre__libelle {
    max-width: 20ch;
    font-size: var(--size-small);
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
  }

  .chiffre--rouge {
    border-left-color: var(--color-accent);
  }

  .chiffre--rouge .chiffre__valeur {
    color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .chiffres {
      grid-template-columns: repeat(4, 1fr);
      gap: 44px 32px;
    }

    .chiffre {
      padding-left: 24px;
    }

    .chiffre__valeur {
      font-size: clamp(40px, 4.2vw, 60px);
    }
  }
</style>
