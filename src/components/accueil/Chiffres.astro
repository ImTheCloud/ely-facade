---
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const chiffres = t(langue).accueil.chiffres;
---

<ul class="chiffres" aria-label={chiffres.aria}>
  {
    chiffres.liste.map((chiffre, i) => (
      <li class:list={['chiffre', { 'chiffre--rouge': i === 2 }]}>
        <span class="chiffre__valeur">{chiffre.valeur}</span>
        <span class="chiffre__libelle">{chiffre.libelle}</span>
      </li>
    ))
  }
</ul>

<style>
  /* Une bande de chiffres posée sur le bas de la photo. */
  .chiffres {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }

  .chiffre {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    padding: 22px 22px 24px;
    border-top: 1px solid var(--color-border);
  }

  .chiffre:nth-child(-n + 2) {
    border-top: 0;
  }

  .chiffre:nth-child(even) {
    border-left: 1px solid var(--color-border);
  }

  .chiffre__valeur {
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .chiffre__libelle {
    font-size: var(--size-small);
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
  }

  .chiffre--rouge .chiffre__valeur {
    color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .chiffres {
      grid-template-columns: repeat(4, 1fr);
    }

    .chiffre {
      padding: 30px 32px 32px;
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }

    .chiffre:first-child {
      border-left: 0;
    }
  }
</style>
