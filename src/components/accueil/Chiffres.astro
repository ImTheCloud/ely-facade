---
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const chiffres = t(langue).accueil.chiffres;
---

<section class="chiffres" aria-label={chiffres.aria}>
  <ul class="wrap chiffres__liste">
    {
      chiffres.liste.map((chiffre) => (
        <li>
          <span class="chiffres__valeur">{chiffre.valeur}</span>
          <span class="chiffres__libelle">{chiffre.libelle}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .chiffres {
    margin-top: var(--section-gap);
    background: var(--color-paper);
    border-top: 12px solid var(--color-accent);
  }

  .chiffres__liste {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-block: 0;
    padding-block: 0;
    list-style: none;
  }

  .chiffres__liste li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 32px 0 32px 20px;
    border-bottom: 3px solid var(--color-ink);
  }

  .chiffres__liste li:nth-child(even) {
    border-left: 3px solid var(--color-ink);
  }

  .chiffres__valeur {
    font-family: var(--font-title);
    font-size: clamp(56px, 6.4vw, 104px);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .chiffres__libelle {
    max-width: 22ch;
    font-size: var(--size-small);
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text);
  }

  @media (min-width: 900px) {
    .chiffres__liste {
      grid-template-columns: repeat(4, 1fr);
    }

    .chiffres__liste li {
      padding: 56px 24px 56px 32px;
      border-bottom: 0;
      border-left: 3px solid var(--color-ink);
    }

    .chiffres__liste li:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
