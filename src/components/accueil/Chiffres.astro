---
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const chiffres = t(langue).accueil.chiffres;
---

<ul class="chiffres" aria-label={chiffres.aria}>
  {
    chiffres.liste.map((chiffre, i) => (
      <li class:list={['chiffre', 'tuile-bento', { 'chiffre--rouge': i === 2 }]}>
        <span class="chiffre__valeur">{chiffre.valeur}</span>
        <span class="chiffre__libelle">{chiffre.libelle}</span>
      </li>
    ))
  }
</ul>

<style>
  .chiffres {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chiffre {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 150px;
    padding: 22px;
  }

  .chiffre__valeur {
    font-size: clamp(38px, 4.4vw, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-ink);
  }

  .chiffre__libelle {
    font-size: var(--size-small);
    font-weight: 550;
    line-height: 1.35;
    color: var(--color-text);
  }

  /* La garantie : la seule tuile teintée de rouge. */
  .chiffre--rouge {
    background: var(--color-accent-soft);
    border-color: #f6d6d8;
  }

  .chiffre--rouge .chiffre__valeur {
    color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .chiffre {
      min-height: 0;
      padding: 28px;
    }
  }
</style>
