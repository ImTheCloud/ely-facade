---
/** Haut de page : une grande photo plein écran, le titre et les boutons à gauche. Rien ne bouge au défilement. */
import { Image } from 'astro:assets';
import Bouton from '../Bouton.astro';
import { heroPhoto } from '../../data/chantiers';
import { entreprise, lienDevis } from '../../data/entreprise';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const hero = textes.accueil.hero;
---

<section class="hero">
  <div class="hero__photo">
    <Image
      src={heroPhoto.image}
      alt={hero.alt}
      widths={[640, 960, 1280, 1600, 2000, 2400]}
      sizes="100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${heroPhoto.cadrage}`}
    />
  </div>
  <div class="hero__voile"></div>

  <div class="hero__texte">
    <div class="hero__contenu">
      <p class="hero__surtitre">{hero.surtitre}</p>
      <h1>{hero.titreDebut} <span class="hero__rouge">{hero.titreFin}</span></h1>
      <p class="hero__lead">{hero.texte}</p>
      <div class="hero__actions">
        <Bouton href={lienDevis(langue)} variante="accent" iconeApres="fleche-diag" large>{textes.actions.devis}</Bouton>
        <Bouton href={`tel:${entreprise.telephoneLien}`} variante="secondaire" icone="telephone" large class="hero__tel">
          {entreprise.telephoneAffiche}
        </Bouton>
      </div>
      <p class="hero__note">{hero.note}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    color: #fff;
    background: #14171a;
  }

  .hero__photo,
  .hero__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Un voile sombre à gauche et en bas : le texte reste lisible, la façade reste visible à droite. */
  .hero__voile {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(8, 14, 22, 0.78) 0%, rgba(8, 14, 22, 0.3) 45%, rgba(8, 14, 22, 0) 70%),
      linear-gradient(to right, rgba(8, 14, 22, 0.5) 0%, rgba(8, 14, 22, 0.12) 55%, rgba(8, 14, 22, 0) 80%);
  }

  .hero__texte {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    height: 100%;
    max-width: calc(var(--content-max) + var(--gutter) * 2);
    margin-inline: auto;
    /* Le bas laisse la place à la barre Appeler / WhatsApp / Devis sur téléphone. */
    padding: calc(var(--header-h) + 24px) var(--gutter) 108px;
  }

  .hero__contenu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 680px;
  }

  .hero__surtitre {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: var(--size-tiny);
    font-weight: 600;
    color: #fff;
  }

  .hero__surtitre::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .hero__contenu h1 {
    font-size: clamp(38px, 5.4vw, 84px);
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 40px rgba(0, 20, 50, 0.35);
  }

  .hero__rouge {
    color: #ff7a81;
  }

  .hero__lead {
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 18px rgba(0, 20, 50, 0.5);
  }

  .hero__actions,
  .hero__note {
    display: none;
  }

  /* L'en-tête est un voile blanc flouté dès l'arrivée : lisible sur la photo. */
  :global(body:has(.hero) .entete) {
    background: rgba(251, 251, 250, 0.84);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
  }

  @media (min-width: 900px) {
    .hero__texte {
      align-items: center;
      padding-bottom: 8vh;
    }

    .hero__lead {
      font-size: var(--size-lead);
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 6px;
    }

    .hero__note {
      display: block;
      font-size: var(--size-small);
      font-weight: 600;
      color: rgba(255, 255, 255, 0.82);
    }

    .hero :global(.hero__tel) {
      background: rgba(255, 255, 255, 0.14);
      border-color: rgba(255, 255, 255, 0.45);
      color: #fff;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .hero :global(.hero__tel:hover) {
      border-color: #fff;
      background: rgba(255, 255, 255, 0.22);
    }
  }
</style>
