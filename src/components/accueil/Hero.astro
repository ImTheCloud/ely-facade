---
/**
 * Haut de page : trois façades terminées en plein écran.
 * En défilant, la façade suivante se construit brique par brique (canvas, voir scripts/briques.ts),
 * avec la brique rouge du logo. Sans JavaScript ou avec « réduire les animations » : une seule photo fixe.
 */
import { Image } from 'astro:assets';
import Bouton from '../Bouton.astro';
import { heroPhotos } from '../../data/chantiers';
import { entreprise, lienDevis } from '../../data/entreprise';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const hero = textes.accueil.hero;
---

<section class="hero" data-briques>
  <div class="hero__scene">
    <canvas class="hero__toile" role="img" aria-label={hero.aria}></canvas>

    <div class="hero__photos">
      {
        heroPhotos.map((photo, i) => (
          <Image
            src={photo.image}
            alt={hero.chantiers[i].alt}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 899px) 230vw, 100vw"
            format="webp"
            loading="eager"
            fetchpriority={i === 0 ? 'high' : undefined}
            data-photo
            data-cadrage={photo.cadrage}
            data-commune={hero.chantiers[i].commune}
          />
        ))
      }
    </div>
    <div class="hero__voile"></div>

    <div class="hero__texte">
      <div class="hero__titre">
        <p class="hero__surtitre">{hero.surtitre}</p>
        <h1>{hero.titreDebut} <span class="hero__rouge">{hero.titreFin}</span></h1>
      </div>

      <div class="hero__cote">
        <p class="hero__lead">{hero.texte}</p>
        <div class="hero__actions">
          <Bouton href={lienDevis(langue)} variante="accent" iconeApres="fleche-diag" large>{textes.actions.devis}</Bouton>
          <Bouton href={`tel:${entreprise.telephoneLien}`} variante="secondaire" icone="telephone" large class="hero__tel">
            {entreprise.telephoneAffiche}
          </Bouton>
        </div>
        <p class="hero__note">{hero.note}</p>
      </div>

      <div class="hero__bas" aria-live="polite">
        <span class="hero__numero" data-numero>01 / 0{heroPhotos.length}</span>
        <span class="hero__commune" data-commune-active>{hero.chantiers[0].commune}</span>
        <span class="hero__points" aria-hidden="true">
          {heroPhotos.map(() => <i><b></b></i>)}
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  import '~/scripts/briques';
</script>

<style>
  .hero {
    position: relative;
    color: #fff;
    background: #14171a;
  }

  .hero__scene {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
  }

  .hero__toile {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Sans canvas : la première photo reste affichée, les autres ne servent qu'au canvas. */
  .hero__photos {
    position: absolute;
    inset: 0;
  }

  .hero__photos img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__photos img:not(:first-child) {
    visibility: hidden;
  }

  .hero__voile {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(12, 14, 16, 0.84) 0%, rgba(12, 14, 16, 0.46) 40%, rgba(12, 14, 16, 0.06) 72%, rgba(12, 14, 16, 0.3) 100%);
  }

  .hero__texte {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 18px;
    height: 100%;
    max-width: calc(var(--content-max) + var(--gutter) * 2);
    margin-inline: auto;
    /* Le bas laisse la place à la barre Appeler / WhatsApp / Devis sur téléphone. */
    padding: calc(var(--header-h) + 24px) var(--gutter) 108px;
  }

  .hero__surtitre {
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
  }

  .hero__titre h1 {
    margin-top: 10px;
    font-size: clamp(44px, 7.4vw, 112px);
    line-height: 0.98;
    color: #fff;
  }

  .hero__rouge {
    color: #ff6a72;
  }

  .hero__lead {
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__actions,
  .hero__note {
    display: none;
  }

  .hero__bas {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 600;
    min-height: 32px;
  }

  .hero__numero {
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.72);
  }

  .hero__points {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }

  .hero__points i {
    display: block;
    width: 28px;
    height: 4px;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.3);
  }

  .hero__points b {
    display: block;
    height: 100%;
    background: #fff;
    transform-origin: left;
    transform: scaleX(var(--f, 0));
  }

  /* Le défilement construit les briques : la scène reste collée pendant ~3 écrans. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero {
      height: 420svh;
    }

    :global(.js) .hero__scene {
      position: sticky;
      top: 0;
    }

    :global(.js) .hero__toile {
      display: block;
    }

    :global(.js) .hero__photos {
      visibility: hidden;
    }
  }

  /* L'en-tête est un voile blanc flouté dès l'arrivée : lisible sur la photo. */
  :global(body:has(.hero) .entete) {
    background: rgba(251, 251, 250, 0.84);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
  }

  /* Téléphone : les photos sont larges, donc la fenêtre est presque carrée (on voit plus de façade) et le texte est dessous. */
  @media (max-width: 899px) {
    .hero__toile,
    .hero__photos {
      inset: auto;
      top: calc(var(--header-h) + 12px);
      left: 12px;
      width: calc(100% - 24px);
      height: 46svh;
      overflow: hidden;
      border-radius: 24px;
    }

    .hero__voile,
    .hero__lead {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .hero__texte {
      display: grid;
      grid-template-columns: 7fr 5fr;
      grid-template-rows: 1fr auto auto;
      align-items: end;
      column-gap: 56px;
      row-gap: 22px;
      padding-bottom: 40px;
    }

    .hero__titre {
      grid-row: 2;
    }

    .hero__cote {
      grid-row: 2;
      grid-column: 2;
      display: grid;
      gap: 20px;
    }

    .hero__bas {
      grid-row: 3;
      grid-column: 1 / -1;
    }

    .hero__lead {
      font-size: var(--size-lead);
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .hero__note {
      display: block;
      font-size: var(--size-small);
      font-weight: 600;
      color: rgba(255, 255, 255, 0.78);
    }

    .hero :global(.hero__tel) {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.4);
      color: #fff;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .hero :global(.hero__tel:hover) {
      border-color: #fff;
      background: rgba(255, 255, 255, 0.2);
    }
  }
</style>
