---
import Bouton from '../Bouton.astro';
import Comparateur from '../Comparateur.astro';
import Chiffres from './Chiffres.astro';
import { paires } from '../../data/chantiers';
import { entreprise, lienDevis } from '../../data/entreprise';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const hero = textes.accueil.hero;
---

<section class="hero">
  <div class="hero__tete">
    <div class="hero__titre">
      <p class="surtitre" style="--i: 0">{hero.surtitre}</p>
      <h1 style="--i: 1">{hero.titreDebut} <span class="hero__rouge">{hero.titreFin}</span></h1>
    </div>

    <div class="hero__suite">
      <p class="hero__lead" style="--i: 2">{hero.texte}</p>
      <div class="hero__actions" style="--i: 3">
        <Bouton href={lienDevis(langue)} variante="accent" iconeApres="fleche-diag" large>{textes.actions.devis}</Bouton>
        <Bouton href={`tel:${entreprise.telephoneLien}`} variante="secondaire" icone="telephone" large>
          {entreprise.telephoneAffiche}
        </Bouton>
      </div>
      <p class="hero__note" style="--i: 4">{hero.note}</p>
    </div>
  </div>

  <Comparateur
    class="hero__scene"
    langue={langue}
    avant={paires.namur.avant}
    apres={paires.namur.apres}
    altAvant={hero.altAvant}
    altApres={hero.altApres}
    cadrage="42% 50%"
    sizes="100vw"
    priorite
    animer
  />

  <div class="hero__chiffres">
    <Chiffres langue={langue} />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(var(--gutter), 1fr) minmax(0, var(--content-max)) minmax(var(--gutter), 1fr);
    row-gap: 28px;
    padding-top: calc(var(--header-h) + 32px);
  }

  /* Mobile : le titre, puis la photo, puis le texte et les boutons. */
  .hero__tete {
    display: contents;
  }

  .hero__titre,
  .hero__suite,
  .hero__chiffres {
    grid-column: 2;
  }

  .hero__titre {
    order: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .hero :global(.hero__scene) {
    order: 1;
    grid-column: 1 / -1;
    height: min(118vw, 600px);
  }

  .hero__suite {
    order: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .hero__chiffres {
    order: 3;
  }

  .hero__titre h1 {
    font-size: clamp(46px, 6.2vw, 92px);
  }

  .hero__rouge {
    color: var(--color-accent);
  }

  .hero__lead {
    max-width: 46ch;
    font-size: var(--size-lead);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__note {
    font-size: var(--size-small);
    font-weight: 600;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__titre > *,
    .hero__suite > * {
      animation: monte 800ms var(--ease-out) backwards;
      animation-delay: calc(var(--i, 0) * 90ms + 100ms);
    }

    @keyframes monte {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
    }
  }

  @media (min-width: 900px) {
    .hero {
      row-gap: 44px;
      padding-top: calc(var(--header-h) + 36px);
    }

    /* Ordinateur : le titre à gauche, le texte à droite, puis la photo sur toute la largeur. */
    .hero__tete {
      display: grid;
      grid-column: 2;
      grid-template-columns: 7fr 5fr;
      align-items: end;
      gap: 56px;
    }

    .hero__titre,
    .hero__suite {
      grid-column: auto;
    }

    .hero :global(.hero__scene) {
      order: 0;
      height: clamp(460px, 46vw, 760px);
    }

    .hero__chiffres {
      order: 0;
      margin-top: -88px;
      position: relative;
      z-index: 5;
    }
  }
</style>
