---
import Bouton from '../Bouton.astro';
import Briques from './Briques.astro';
import Chiffres from './Chiffres.astro';
import { entreprise, lienDevis } from '../../data/entreprise';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const hero = textes.accueil.hero;
---

<section class="hero">
  <div class="wrap">
    <div class="hero__texte">
      <p class="surtitre" style="--i: 0">{hero.surtitre}</p>
      <h1 style="--i: 1">{hero.titreDebut} <span class="hero__rouge">{hero.titreFin}</span></h1>
      <p class="hero__lead" style="--i: 2">{hero.texte}</p>
      <div class="hero__actions" style="--i: 3">
        <Bouton href={lienDevis(langue)} variante="accent" iconeApres="fleche-diag" large>{textes.actions.devis}</Bouton>
        <Bouton href={`tel:${entreprise.telephoneLien}`} variante="secondaire" icone="telephone" large>
          {entreprise.telephoneAffiche}
        </Bouton>
      </div>
      <p class="hero__note" style="--i: 4">{hero.note}</p>
    </div>

    <!-- Les tuiles « bento » : le motif du logo et les chiffres. Une photo prendra la place du motif. -->
    <div class="bento">
      <div class="bento__visuel tuile-bento" aria-hidden="true"><Briques /></div>
      <Chiffres langue={langue} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + 40px);
  }

  .hero__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 920px;
    margin-bottom: 56px;
  }

  .hero__rouge {
    color: var(--color-accent);
  }

  .hero__lead {
    max-width: 52ch;
    font-size: var(--size-lead);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__note {
    font-size: var(--size-small);
    font-weight: 600;
    color: var(--color-muted);
  }

  .bento {
    display: grid;
    gap: var(--tile-gap);
  }

  .bento__visuel {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    padding: 36px;
    background: linear-gradient(160deg, #ffffff 0%, var(--color-surface) 100%);
    overflow: hidden;
  }

  .bento__visuel :global(.briques) {
    width: min(100%, 240px);
  }

  /* Le texte monte au chargement, sans JavaScript. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__texte > * {
      animation: monte 800ms var(--ease-out) backwards;
      animation-delay: calc(var(--i, 0) * 90ms + 100ms);
    }

    .bento > * {
      animation: monte 900ms var(--ease-out) 450ms backwards;
    }

    @keyframes monte {
      from {
        opacity: 0;
        transform: translateY(28px);
      }
    }
  }

  @media (min-width: 900px) {
    .hero {
      padding-top: calc(var(--header-h) + 72px);
    }

    .hero__texte {
      margin-bottom: 72px;
    }

    .bento {
      grid-template-columns: 7fr 5fr;
    }

    .bento__visuel {
      min-height: 460px;
    }

    .bento__visuel :global(.briques) {
      width: min(100%, 300px);
    }
  }
</style>
