---
import Bouton from '../Bouton.astro';
import Briques from './Briques.astro';
import { entreprise, lienDevis } from '../../data/entreprise';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const hero = textes.accueil.hero;
---

<section class="hero">
  <div class="wrap hero__grille">
    <div class="hero__texte">
      <p class="surtitre" style="--i: 0">{hero.surtitre}</p>
      <h1 style="--i: 1">{hero.titreDebut} <span class="hero__rouge">{hero.titreFin}</span></h1>
      <p class="hero__lead" style="--i: 2">{hero.texte}</p>
      <div class="hero__actions" style="--i: 3">
        <Bouton href={lienDevis(langue)} variante="accent" iconeApres="fleche-diag" large>{textes.actions.devis}</Bouton>
        <Bouton href={`tel:${entreprise.telephoneLien}`} variante="secondaire" icone="telephone" large>
          {entreprise.telephoneAffiche}
        </Bouton>
      </div>
      <p class="hero__note" style="--i: 4">{hero.note}</p>
    </div>

    <div class="hero__briques"><Briques /></div>
  </div>
</section>

<style>
  .hero {
    padding: calc(var(--header-h) + 48px) 0 0;
  }

  .hero__grille {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .hero__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .hero h1 {
    font-size: clamp(60px, 8.4vw, 136px);
  }

  .hero__rouge {
    color: var(--color-accent);
  }

  .hero__lead {
    max-width: 50ch;
    font-size: var(--size-lead);
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hero__note {
    font-size: var(--size-small);
    font-weight: 700;
    color: var(--color-ink);
  }

  .hero__briques {
    width: min(70%, 320px);
    margin-inline: auto;
  }

  /* Le texte monte au chargement, sans JavaScript. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__texte > * {
      animation: monte 800ms var(--ease-out) backwards;
      animation-delay: calc(var(--i, 0) * 90ms + 100ms);
    }

    @keyframes monte {
      from {
        opacity: 0;
        transform: translateY(32px);
      }
    }
  }

  @media (min-width: 960px) {
    .hero {
      padding-top: calc(var(--header-h) + 88px);
    }

    .hero__grille {
      grid-template-columns: 1.7fr 1fr;
      gap: 72px;
    }

    .hero__briques {
      width: 100%;
      max-width: 460px;
      margin-inline: 0 auto;
    }
  }
</style>
