---
/** Haut de page : la plus belle façade terminée en plein écran, le titre et les boutons dessus. Rien ne bouge au défilement. */
import { Image } from 'astro:assets';
import Bouton from '../Bouton.astro';
import { heroPhoto } from '../../data/chantiers';
import { entreprise, lienDevis } from '../../data/entreprise';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const hero = textes.accueil.hero;
---

<section class="hero">
  <div class="hero__photo">
    <Image
      src={heroPhoto.image}
      alt={hero.alt}
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 899px) 230vw, 100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${heroPhoto.cadrage}`}
    />
  </div>
  <div class="hero__voile"></div>

  <div class="hero__texte">
    <div class="hero__titre">
      <p class="hero__surtitre">{hero.surtitre}</p>
      <h1>{hero.titreDebut} <span class="hero__rouge">{hero.titreFin}</span></h1>
    </div>

    <div class="hero__cote">
      <p class="hero__lead">{hero.texte}</p>
      <div class="hero__actions">
        <Bouton href={lienDevis(langue)} variante="accent" iconeApres="fleche-diag" large>{textes.actions.devis}</Bouton>
        <Bouton href={`tel:${entreprise.telephoneLien}`} variante="secondaire" icone="telephone" large class="hero__tel">
          {entreprise.telephoneAffiche}
        </Bouton>
      </div>
      <p class="hero__note">{hero.note}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    color: #fff;
    background: #14171a;
  }

  .hero__photo,
  .hero__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__voile {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(12, 14, 16, 0.84) 0%, rgba(12, 14, 16, 0.46) 40%, rgba(12, 14, 16, 0.06) 72%, rgba(12, 14, 16, 0.3) 100%);
  }

  .hero__texte {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 18px;
    height: 100%;
    max-width: calc(var(--content-max) + var(--gutter) * 2);
    margin-inline: auto;
    /* Le bas laisse la place à la barre Appeler / WhatsApp / Devis sur téléphone. */
    padding: calc(var(--header-h) + 24px) var(--gutter) 108px;
  }

  .hero__surtitre {
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
  }

  .hero__titre h1 {
    margin-top: 10px;
    font-size: clamp(44px, 6.2vw, 96px);
    line-height: 0.98;
    color: #fff;
  }

  .hero__rouge {
    color: #ff6a72;
  }

  .hero__lead {
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__actions,
  .hero__note {
    display: none;
  }

  /* L'en-tête est un voile blanc flouté dès l'arrivée : lisible sur la photo. */
  :global(body:has(.hero) .entete) {
    background: rgba(251, 251, 250, 0.84);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
  }

  /* Téléphone : la photo est large, donc la fenêtre est presque carrée (on voit plus de façade) et le texte est dessous. */
  @media (max-width: 899px) {
    .hero__photo {
      inset: auto;
      top: calc(var(--header-h) + 12px);
      left: 12px;
      width: calc(100% - 24px);
      height: 46svh;
      overflow: hidden;
      border-radius: 24px;
    }

    .hero__voile,
    .hero__lead {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .hero__texte {
      display: grid;
      grid-template-columns: 7fr 5fr;
      align-items: end;
      column-gap: 56px;
      padding-bottom: 48px;
    }

    .hero__lead {
      font-size: var(--size-lead);
    }

    .hero__cote {
      display: grid;
      gap: 20px;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .hero__note {
      display: block;
      font-size: var(--size-small);
      font-weight: 600;
      color: rgba(255, 255, 255, 0.78);
    }

    .hero :global(.hero__tel) {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.4);
      color: #fff;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .hero :global(.hero__tel:hover) {
      border-color: #fff;
      background: rgba(255, 255, 255, 0.2);
    }
  }
</style>
