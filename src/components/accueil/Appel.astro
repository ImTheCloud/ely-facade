---
import Bouton from '../Bouton.astro';
import { entreprise, lienDevis, lienWhatsApp } from '../../data/entreprise';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const appel = textes.accueil.appel;
---

<section class="appel">
  <div class="wrap">
    <div class="appel__bloc" data-reveal>
      <h2>{appel.titre}</h2>
      <p>{appel.texte}</p>
      <div class="appel__actions">
        <Bouton href={lienDevis(langue)} variante="accent" iconeApres="fleche-diag" large>{textes.actions.devis}</Bouton>
        <Bouton href={lienWhatsApp(textes.whatsappMessage)} variante="whatsapp" icone="whatsapp" large target="_blank" rel="noopener">
          WhatsApp
        </Bouton>
        <Bouton href={`tel:${entreprise.telephoneLien}`} variante="secondaire" icone="telephone" large>
          {entreprise.telephoneAffiche}
        </Bouton>
      </div>
    </div>
  </div>
</section>

<style>
  .appel {
    margin-top: var(--section-gap);
  }

  .appel__bloc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding: 40px 24px;
    background: #fff;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    box-shadow: 10px 10px 0 var(--color-accent);
  }

  .appel__bloc p {
    max-width: 56ch;
    font-size: var(--size-lead);
  }

  .appel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (min-width: 900px) {
    .appel__bloc {
      padding: 72px 64px;
    }
  }
</style>
