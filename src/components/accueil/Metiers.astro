---
import Icon from '../Icon.astro';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const metiers = t(langue).accueil.metiers;
---

<section class="metiers" id="metiers">
  <div class="wrap">
    <div class="metiers__tete" data-reveal>
      <p class="surtitre">{metiers.surtitre}</p>
      <h2>{metiers.titre}</h2>
      <p class="metiers__texte">{metiers.texte}</p>
    </div>

    <ul class="metiers__liste">
      {
        metiers.liste.map((metier, i) => (
          <li class="carte tuile-bento" data-reveal style={`--delai: ${i * 70}ms`}>
            <span class="carte__icone"><Icon nom={metier.icone} taille={28} /></span>
            <h3>{metier.titre}</h3>
            <p>{metier.texte}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .metiers {
    margin-top: var(--section-gap);
  }

  .metiers__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 760px;
    margin-bottom: 40px;
  }

  .metiers__texte {
    font-size: var(--size-lead);
  }

  .metiers__liste {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .carte {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    transition:
      transform var(--speed) var(--ease),
      box-shadow var(--speed) var(--ease);
  }

  .carte:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .carte__icone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 12px;
    border-radius: 18px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  @media (min-width: 700px) {
    .metiers__liste {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .metiers__liste {
      grid-template-columns: repeat(6, 1fr);
    }

    .carte {
      grid-column: span 2;
      min-height: 280px;
    }

    /* Cinq tuiles : trois en haut, deux plus larges en bas. */
    .carte:nth-child(n + 4) {
      grid-column: span 3;
      min-height: 0;
    }
  }
</style>
