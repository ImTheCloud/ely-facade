---
/** Les cinq métiers, chacun mène à sa page. Uniquement la façade. */
import Icon from '../Icon.astro';
import { METIERS, lienMetier } from '../../data/metiers';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const section = textes.accueil.metiers;
---

<section class="section section--ardoise metiers" id="metiers">
  <div class="wrap">
    <div class="tete" data-reveal>
      <p class="surtitre">{section.surtitre}</p>
      <h2>{section.titre}</h2>
      <p>{section.texte}</p>
    </div>

    <ul class="metiers__liste">
      {
        METIERS.map((metier, i) => (
          <li data-reveal style={`--delai: ${i * 70}ms`}>
            <a class="metier" href={lienMetier(metier.cle, langue)}>
              <span class="metier__icone">
                <Icon nom={metier.icone} taille={28} />
              </span>
              <span class="metier__num" aria-hidden="true">0{i + 1}</span>
              <h3>{textes.metiers[metier.cle].titre}</h3>
              <p>{textes.metiers[metier.cle].court}</p>
              <span class="metier__voir">
                {section.voir}
                <Icon nom="fleche" taille={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .metiers {
    border-radius: 36px;
    margin-inline: clamp(0px, 1.2vw, 16px);
  }

  .metiers__liste {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .metier {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-tile);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition:
      background-color var(--speed) var(--ease),
      border-color var(--speed) var(--ease),
      transform var(--speed) var(--ease);
  }

  .metier:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-4px);
  }

  .metier:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .metier__icone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 10px;
    border-radius: 18px;
    background: var(--color-accent);
    color: #fff;
  }

  .metier__num {
    position: absolute;
    top: 26px;
    right: 28px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.4);
  }

  .metier h3 {
    color: #fff;
    font-size: clamp(22px, 1.9vw, 28px);
    font-weight: 800;
  }

  .metier p {
    flex: 1;
  }

  .metier__voir {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-weight: 700;
    color: #fff;
  }

  .metier__voir :global(svg) {
    transition: transform var(--speed) var(--ease);
  }

  .metier:hover .metier__voir :global(svg) {
    transform: translateX(4px);
  }

  @media (min-width: 700px) {
    .metiers__liste {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .metiers__liste {
      grid-template-columns: repeat(6, 1fr);
    }

    .metiers__liste li {
      grid-column: span 2;
    }

    /* Cinq tuiles : trois en haut, deux plus larges en bas. */
    .metiers__liste li:nth-child(n + 4) {
      grid-column: span 3;
    }
  }
</style>
