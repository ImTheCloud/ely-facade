---
import Icon from '../Icon.astro';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const metiers = t(langue).accueil.metiers;
---

<section class="metiers" id="metiers">
  <div class="wrap">
    <div class="metiers__tete" data-reveal>
      <p class="surtitre">{metiers.surtitre}</p>
      <h2>{metiers.titre}</h2>
      <p class="metiers__texte">{metiers.texte}</p>
    </div>

    <ol class="metiers__liste">
      {
        metiers.liste.map((metier, i) => (
          <li class="ligne" data-reveal>
            <span class="ligne__num" aria-hidden="true">0{i + 1}</span>
            <h3>{metier.titre}</h3>
            <p>{metier.texte}</p>
            <span class="ligne__icone"><Icon nom={metier.icone} taille={32} /></span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .metiers {
    margin-top: var(--section-gap);
  }

  .metiers__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 1000px;
    margin-bottom: 56px;
  }

  .metiers__texte {
    font-size: var(--size-lead);
  }

  .metiers__liste {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: var(--trait) solid var(--color-ink);
  }

  .ligne {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 20px;
    row-gap: 10px;
    padding: 28px 0;
    border-top: var(--trait) solid var(--color-ink);
  }

  .ligne__num {
    grid-row: span 2;
    font-family: var(--font-title);
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1;
    color: var(--color-accent);
  }

  .ligne h3 {
    font-size: clamp(34px, 5vw, 72px);
    line-height: 0.98;
  }

  .ligne p {
    max-width: 52ch;
  }

  .ligne__icone {
    display: none;
  }

  @media (min-width: 900px) {
    .ligne {
      grid-template-columns: 88px 1.1fr 1fr 72px;
      align-items: center;
      column-gap: 32px;
      padding: 40px 0;
    }

    .ligne__num {
      grid-row: auto;
    }

    .ligne__icone {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 72px;
      height: 72px;
      background: var(--color-ink);
      color: #fff;
    }
  }
</style>
