---
import { Image } from 'astro:assets';
import { photos, type ClePhoto } from '../../data/chantiers';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const chantiers = t(langue).accueil.chantiers;
---

<section class="chantiers" data-niveau={chantiers.surtitre}>
  <div class="wrap">
    <div class="chantiers__tete" data-reveal>
      <p class="surtitre">{chantiers.surtitre}</p>
      <h2>{chantiers.titre}</h2>
      <p class="chantiers__texte">{chantiers.texte}</p>
    </div>

    <ul class="chantiers__grille">
      {
        chantiers.liste.map((chantier, i) => (
          <li class={`photo photo--${chantier.cle} tuile-bento`} data-reveal style={`--delai: ${(i % 3) * 80}ms`}>
            <Image
              src={photos[chantier.cle as ClePhoto]}
              alt={`${chantier.commune} : ${chantier.legende}`}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1100px) 60vw, 100vw"
              loading="lazy"
              format="webp"
            />
            <p class="photo__legende">
              <strong>{chantier.commune}</strong>
              <span>{chantier.legende}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .chantiers {
    margin-top: var(--section-gap);
  }

  .chantiers__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 760px;
    margin-bottom: 40px;
  }

  .chantiers__texte {
    font-size: var(--size-lead);
  }

  .chantiers__grille {
    display: grid;
    gap: var(--tile-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  .photo--echafaudage {
    aspect-ratio: 3 / 4;
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .photo:hover :global(img) {
    transform: scale(1.04);
  }

  .photo__legende {
    position: absolute;
    left: 12px;
    bottom: 12px;
    right: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    width: fit-content;
    max-width: calc(100% - 24px);
    padding: 9px 16px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    font-size: var(--size-tiny);
    line-height: 1.3;
    color: var(--color-text);
  }

  .photo__legende strong {
    color: var(--color-ink);
  }

  @media (min-width: 700px) {
    .chantiers__grille {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .chantiers__grille {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: 300px;
    }

    .photo {
      aspect-ratio: auto;
    }

    .photo--echafaudage {
      aspect-ratio: auto;
    }

    .photo--grand { grid-column: span 8; }
    .photo--echafaudage { grid-column: span 4; grid-row: span 2; }
    .photo--immeuble { grid-column: span 4; }
    .photo--angle { grid-column: span 4; }
    .photo--isolation { grid-column: span 5; }
    .photo--namur { grid-column: span 7; }
    .photo--maisons { grid-column: span 4; }
    .photo--finie { grid-column: span 8; }
  }
</style>
