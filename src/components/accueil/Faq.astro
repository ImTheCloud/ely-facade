---
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const faq = t(langue).accueil.faq;
---

<section class="faq">
  <div class="wrap">
    <div class="faq__tuile tuile-bento" data-reveal>
      <div class="faq__tete">
        <p class="surtitre">{faq.surtitre}</p>
        <h2>{faq.titre}</h2>
      </div>

      <!-- <details> natif : ça marche au clavier et sans JavaScript. -->
      <div class="faq__liste">
        {
          faq.liste.map((element) => (
            <details>
              <summary>{element.question}</summary>
              <p>{element.reponse}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    margin-top: var(--section-gap);
  }

  .faq__tuile {
    display: grid;
    gap: 32px;
    padding: 28px 24px;
  }

  .faq__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  details {
    border-top: 1px solid var(--color-border);
  }

  details:first-child {
    border-top: 0;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 72px;
    padding-block: 12px;
    font-size: var(--size-lead);
    font-weight: 650;
    line-height: 1.3;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Le « + » devient « − » quand la réponse est ouverte. */
  summary::after {
    content: '+';
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 24px;
    font-weight: 500;
    line-height: 1;
    transition: background-color var(--speed) var(--ease), color var(--speed) var(--ease);
  }

  details[open] summary::after {
    content: '−';
    background: var(--color-accent);
    color: #fff;
  }

  details p {
    max-width: 62ch;
    padding-bottom: 24px;
  }

  @media (min-width: 900px) {
    .faq__tuile {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
      padding: 64px;
    }
  }
</style>
