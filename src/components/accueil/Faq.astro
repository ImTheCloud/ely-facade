---
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const faq = t(langue).accueil.faq;
---

<section class="faq">
  <div class="wrap faq__grille">
    <div class="faq__tete" data-reveal>
      <p class="surtitre">{faq.surtitre}</p>
      <h2>{faq.titre}</h2>
    </div>

    <!-- <details> natif : ça marche au clavier et sans JavaScript. -->
    <div class="faq__liste" data-reveal>
      {
        faq.liste.map((element) => (
          <details>
            <summary>{element.question}</summary>
            <p>{element.reponse}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    margin-top: var(--section-gap);
  }

  .faq__grille {
    display: grid;
    gap: 36px;
  }

  .faq__tete {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .faq__liste {
    border-bottom: 2px solid var(--color-ink);
  }

  details {
    border-top: 2px solid var(--color-ink);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 68px;
    padding-block: 12px;
    font-size: var(--size-lead);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Le « + » rouge devient « − » quand la réponse est ouverte. */
  summary::after {
    content: '+';
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    font-size: 24px;
    font-weight: 500;
    line-height: 1;
  }

  details[open] summary::after {
    content: '−';
  }

  details p {
    max-width: 62ch;
    padding-bottom: 24px;
  }

  @media (min-width: 900px) {
    .faq__grille {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
    }
  }
</style>
