---
/**
 * Dessin du haut de l'accueil : des immeubles en escalier (comme le logo),
 * l'un sous échafaudage rouge. C'est un dessin, pas une photo de chantier.
 */
interface Props {
  titre: string;
}

const { titre } = Astro.props;

const SOL = 440;
const immeubles = [
  { x: 14, l: 124, h: 190, ancien: true },
  { x: 138, l: 168, h: 330, echafaudage: true },
  { x: 306, l: 134, h: 252 },
  { x: 440, l: 146, h: 142, ancien: true },
].map((b) => {
  const colonnes = Math.max(1, Math.floor((b.l - 20) / 44));
  const rangees = Math.max(1, Math.floor((b.h - 36) / 66));
  const fenetres = [];
  for (let c = 0; c < colonnes; c++) {
    for (let r = 0; r < rangees; r++) {
      const pas = (b.l - 20) / colonnes;
      fenetres.push({ x: b.x + 10 + pas * c + (pas - 26) / 2, y: SOL - b.h + 30 + r * 66 });
    }
  }
  const montants = [];
  const traverses = [];
  if (b.echafaudage) {
    for (let x = b.x - 10; x <= b.x + b.l + 10; x += 44) montants.push(x);
    for (let y = SOL - 8; y > SOL - b.h + 20; y -= 66) traverses.push(y);
  }
  return { ...b, y: SOL - b.h, fenetres, montants, traverses };
});
---

<svg viewBox="0 0 600 480" role="img" aria-label={titre} class="immeubles" fill="none">
  {
    immeubles.map((b) => (
      <g>
        <rect x={b.x} y={b.y} width={b.l} height={b.h} fill={b.ancien ? 'var(--color-surface-2)' : '#fff'} stroke="var(--color-ink)" stroke-width="5" stroke-linejoin="round" />
        {b.fenetres.map((f) => (
          <rect x={f.x} y={f.y} width="26" height="40" fill="var(--color-bg)" stroke="var(--color-ink)" stroke-width="4" />
        ))}
        {b.montants.map((x) => (
          <line x1={x} y1={SOL} x2={x} y2={b.y - 14} stroke="var(--color-accent)" stroke-width="4" />
        ))}
        {b.traverses.map((y) => (
          <line x1={b.x - 10} y1={y} x2={b.x + b.l + 10} y2={y} stroke="var(--color-accent)" stroke-width="4" />
        ))}
      </g>
    ))
  }
  <line x1="0" y1={SOL} x2="600" y2={SOL} stroke="var(--color-ink)" stroke-width="6" />
  <rect x="0" y={SOL + 14} width="600" height="10" fill="var(--color-accent)" />
</svg>

<style>
  .immeubles {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
