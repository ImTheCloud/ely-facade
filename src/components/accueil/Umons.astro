---
/**
 * Le chantier de référence : l'Université de Mons (UMons), citée avec l'accord d'Elisei.
 * Seulement ce que montrent les photos : trois bâtiments, de l'échafaudage à la façade terminée.
 */
import Bouton from '../Bouton.astro';
import Comparateur from '../Comparateur.astro';
import { chantier } from '../../data/chantiers';
import { chemin, t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const section = textes.accueil.umons;
const umons = chantier('umons');
const fiche = textes.chantiers.umons;
---

<section class="section umons" id="umons">
  <div class="wrap umons__grille">
    <figure class="umons__photo" data-reveal>
      <Comparateur langue={langue} paire={umons.paires[1]} sizes="(min-width: 1360px) 760px, (min-width: 960px) 58vw, 100vw" />
      <figcaption>
        <strong>{textes.communes.mons}</strong> · {fiche.batiments[2]}
      </figcaption>
    </figure>

    <div class="umons__texte" data-reveal style="--delai: 120ms">
      <p class="surtitre">{section.pastille}</p>
      <h2>{fiche.titre}</h2>
      <p class="umons__intro">{section.texte}</p>
      <ul class="umons__liste">
        {
          fiche.batiments.map((batiment) => (
            <li>
              <span class="brique" aria-hidden="true" />
              {batiment}
            </li>
          ))
        }
      </ul>
      <Bouton href={`${chemin('realisations', langue)}${umons.slug[langue]}/`} variante="principal" iconeApres="fleche" large>
        {section.voir}
      </Bouton>
    </div>
  </div>
</section>

<style>
  .umons {
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface) 100%);
  }

  .umons__grille {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .umons__photo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
  }

  .umons__photo figcaption {
    padding-inline: 4px;
    font-size: var(--size-small);
    color: var(--color-text);
  }

  .umons__photo strong {
    color: var(--color-ink);
  }

  .umons__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .umons__intro {
    max-width: 48ch;
    font-size: var(--size-lead);
    line-height: 1.55;
  }

  .umons__liste {
    display: grid;
    gap: 10px;
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
  }

  .umons__liste li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 600;
    color: var(--color-ink);
  }

  @media (min-width: 960px) {
    .umons__grille {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 72px;
    }
  }
</style>
