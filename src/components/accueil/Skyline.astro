---
/**
 * Une ligne d'immeubles en escalier, comme le logo. Deux états du même dessin :
 * « avant » (façades sales, fissurées, échafaudage rouge) et « après » (façades
 * blanches). Le Hero superpose les deux et un rouleau les révèle.
 * C'est un dessin, pas une photo de chantier.
 */
interface Props {
  etat: 'avant' | 'apres';
}

const { etat } = Astro.props;
const avant = etat === 'avant';

const SOL = 430;
const immeubles = [
  { x: 0, l: 170, h: 150 },
  { x: 170, l: 190, h: 230 },
  { x: 360, l: 160, h: 190 },
  { x: 520, l: 200, h: 310, echafaudage: true },
  { x: 720, l: 170, h: 260 },
  { x: 890, l: 210, h: 370, echafaudage: true, bande: true },
  { x: 1100, l: 160, h: 290 },
  { x: 1260, l: 140, h: 210 },
].map((b, i) => {
  const colonnes = Math.max(1, Math.floor((b.l - 24) / 46));
  const rangees = Math.max(1, Math.floor((b.h - 40) / 70));
  const pas = (b.l - 24) / colonnes;
  const fenetres = [];
  for (let c = 0; c < colonnes; c++) {
    for (let r = 0; r < rangees; r++) {
      fenetres.push({ x: b.x + 12 + pas * c + (pas - 28) / 2, y: SOL - b.h + 34 + r * 70 });
    }
  }
  const haut = SOL - b.h;
  // Taches et fissure : calculées à partir de la position, donc toujours identiques.
  const taches = [
    { cx: b.x + b.l * (0.3 + 0.1 * (i % 3)), cy: haut + b.h * 0.35, rx: b.l * 0.28, ry: 26 + (i % 3) * 8 },
    { cx: b.x + b.l * (0.7 - 0.08 * (i % 2)), cy: haut + b.h * 0.72, rx: b.l * 0.22, ry: 30 },
  ];
  const fx = b.x + b.l * (0.45 + 0.05 * (i % 4));
  const fissure = `${fx},${haut + 8} ${fx + 9},${haut + 46} ${fx - 6},${haut + 78} ${fx + 8},${haut + 120}`;
  const montants = [];
  const traverses = [];
  if (b.echafaudage) {
    for (let x = b.x + 4; x <= b.x + b.l - 4; x += 48) montants.push(x);
    for (let y = SOL - 6; y > haut + 10; y -= 70) traverses.push(y);
  }
  return { ...b, haut, fenetres, taches, fissure, montants, traverses };
});
---

<svg viewBox={`0 0 1400 ${SOL + 4}`} fill="none" aria-hidden="true" focusable="false" class="skyline">
  {
    immeubles.map((b) => (
      <g>
        <rect
          x={b.x + 2}
          y={b.haut}
          width={b.l - 4}
          height={SOL - b.haut}
          fill={avant ? '#cfcfca' : '#ffffff'}
          stroke="var(--color-ink)"
          stroke-width="5"
          stroke-linejoin="round"
        />
        {!avant && b.bande && (
          <rect x={b.x + 4.5} y={b.haut + 20} width={b.l - 9} height="22" fill="var(--color-accent)" />
        )}
        {avant && b.taches.map((tache) => (
          <ellipse cx={tache.cx} cy={tache.cy} rx={tache.rx} ry={tache.ry} fill="#4a4338" opacity="0.2" />
        ))}
        {avant && <polyline points={b.fissure} stroke="#6f6a60" stroke-width="3" stroke-linejoin="round" />}
        {b.fenetres.map((f) => (
          <rect x={f.x} y={f.y} width="28" height="44" fill={avant ? '#b9b9b4' : '#eaf2f8'} stroke="var(--color-ink)" stroke-width="4" />
        ))}
        {avant && b.montants.map((x) => (
          <line x1={x} y1={SOL} x2={x} y2={b.haut - 18} stroke="var(--color-accent)" stroke-width="4" />
        ))}
        {avant && b.traverses.map((y) => (
          <line x1={b.x + 4} y1={y} x2={b.x + b.l - 4} y2={y} stroke="var(--color-accent)" stroke-width="4" />
        ))}
      </g>
    ))
  }
  <line x1="0" y1={SOL + 1} x2="1400" y2={SOL + 1} stroke="var(--color-ink)" stroke-width="6" />
</svg>

<style>
  .skyline {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
