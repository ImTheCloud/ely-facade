---
/**
 * La section « avis » (#avis) : le QR code qui mène à la page où le client écrit son avis Google.
 * Elisei la montre à la fin du chantier pour que le client scanne le code avec son téléphone.
 */
import QRCode from 'qrcode';
import Bouton from '../Bouton.astro';
import { lienAvisGoogle } from '../../data/google';
import { t, type Langue } from '../../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const avis = t(langue).accueil.avis;

// Le QR code est dessiné à la construction du site : aucun service extérieur, il encode directement le lien d'avis.
const qr = QRCode.create(lienAvisGoogle, { errorCorrectionLevel: 'M' });
const n = qr.modules.size;
const marge = 2;
let cases = '';
for (let y = 0; y < n; y++) for (let x = 0; x < n; x++) if (qr.modules.get(x, y)) cases += `M${x + marge} ${y + marge}h1v1h-1z`;
const cote = n + 2 * marge;
---

<section class="section avis" id="avis">
  <div class="wrap">
    <div class="avis__qr tuile-bento">
      <svg
        class="avis__code"
        viewBox={`0 0 ${cote} ${cote}`}
        shape-rendering="crispEdges"
        role="img"
        aria-label={avis.alt}
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect width={cote} height={cote} fill="#fff"></rect>
        <path d={cases} fill="#1f2429"></path>
      </svg>
      <div class="avis__texte">
        <h2>{avis.titre}</h2>
        <p>{avis.texte}</p>
        <Bouton href={lienAvisGoogle} variante="principal" iconeApres="fleche-diag" target="_blank" rel="noopener">{avis.bouton}</Bouton>
      </div>
    </div>
  </div>
</section>

<style>
  .avis__qr {
    display: grid;
    justify-items: center;
    gap: 22px;
    padding: clamp(22px, 4vw, 40px);
    text-align: center;
  }

  .avis__code {
    width: min(240px, 70vw);
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  .avis__texte {
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 44ch;
  }

  .avis__texte h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.05;
  }

  .avis__texte p {
    margin: 0;
  }

  @media (min-width: 700px) {
    .avis__qr {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      gap: clamp(28px, 4vw, 56px);
      text-align: left;
    }

    .avis__texte {
      justify-items: start;
    }
  }
</style>
