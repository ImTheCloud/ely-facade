---
/**
 * Petit dock flottant en bas de l'écran, sur mobile uniquement.
 * Il apparaît dès qu'on a quitté le haut de la page : appeler, WhatsApp
 * et devis restent toujours au pouce.
 */
import Icon from './Icon.astro';
import { entreprise, lienDevis, lienWhatsApp } from '../data/entreprise';
import { t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
---

<div class="dock" data-dock>
  <a href={`tel:${entreprise.telephoneLien}`} class="dock__bouton" aria-label={`${textes.actions.appeler} ${entreprise.telephoneAffiche}`}>
    <Icon nom="telephone" taille={22} />
  </a>
  <a href={lienWhatsApp(textes.whatsappMessage)} class="dock__bouton dock__bouton--whatsapp" target="_blank" rel="noopener" aria-label={textes.actions.whatsapp}>
    <Icon nom="whatsapp" taille={22} />
  </a>
  <a href={lienDevis(langue)} class="dock__devis">
    {textes.actions.devis}
    <Icon nom="fleche-diag" taille={18} epaisseur={2.4} />
  </a>
</div>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    let surLeDevis = false;
    const mettreAJour = () => {
      const bas = window.innerHeight + window.scrollY >= document.body.scrollHeight - 40;
      dock.classList.toggle('dock--visible', window.scrollY > window.innerHeight * 0.5 && !bas && !surLeDevis);
    };
    // Le dock se retire quand le formulaire de devis est à l'écran : il cacherait ses boutons.
    const formulaire = document.getElementById('devis');
    if (formulaire) {
      new IntersectionObserver(
        (entrees) => {
          surLeDevis = entrees.some((entree) => entree.isIntersecting);
          mettreAJour();
        },
        { rootMargin: '0px 0px -30% 0px' },
      ).observe(formulaire);
    }
    window.addEventListener('scroll', mettreAJour, { passive: true });
    mettreAJour();
  }
</script>

<style>
  /* Une barre pleine largeur collée en bas : appeler, WhatsApp, devis. */
  .dock {
    position: fixed;
    inset: auto 0 0;
    z-index: 55;
    display: flex;
    align-items: stretch;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background: var(--color-ink);
    border-top: var(--trait) solid var(--color-accent);
    transform: translateY(110%);
    transition: transform 400ms var(--ease-out);
  }

  .dock--visible {
    transform: none;
  }

  .dock__bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    min-height: 60px;
    color: #fff;
    border-right: 2px solid var(--color-line-on-ink);
  }

  .dock__bouton--whatsapp {
    background: var(--color-whatsapp);
    border-right: 0;
  }

  .dock__devis {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 60px;
    padding: 0 20px;
    background: var(--color-accent);
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  :global(body.menu-ouvert) .dock {
    display: none;
  }

  @media (min-width: 1024px) {
    .dock {
      display: none;
    }
  }
</style>
