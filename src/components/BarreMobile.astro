---
/**
 * Barre collée en bas de l'écran, sur mobile uniquement.
 * Elle apparaît dès qu'on a quitté le haut de la page : appeler, WhatsApp
 * et devis restent toujours au pouce.
 */
import Icon from './Icon.astro';
import { entreprise, lienDevis, lienWhatsApp } from '../data/entreprise';
import { t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
---

<div class="dock" data-dock>
  <a href={`tel:${entreprise.telephoneLien}`} class="dock__lien" aria-label={`${textes.actions.appeler} ${entreprise.telephoneAffiche}`}>
    <Icon nom="telephone" taille={22} />
    <span>{textes.actions.appeler}</span>
  </a>
  <a href={lienWhatsApp(textes.whatsappMessage)} class="dock__lien dock__lien--whatsapp" target="_blank" rel="noopener" aria-label={textes.actions.whatsapp}>
    <Icon nom="whatsapp" taille={22} />
    <span>WhatsApp</span>
  </a>
  <a href={lienDevis(langue)} class="dock__devis">
    {textes.actions.devis}
    <Icon nom="fleche-diag" taille={18} epaisseur={2.2} />
  </a>
</div>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    let surLeDevis = false;
    const mettreAJour = () => {
      const bas = window.innerHeight + window.scrollY >= document.body.scrollHeight - 40;
      dock.classList.toggle('dock--visible', window.scrollY > window.innerHeight * 0.5 && !bas && !surLeDevis);
    };
    // Le dock se retire quand le formulaire de devis est à l'écran : il cacherait ses boutons.
    const formulaire = document.getElementById('devis');
    if (formulaire) {
      new IntersectionObserver(
        (entrees) => {
          surLeDevis = entrees.some((entree) => entree.isIntersecting);
          mettreAJour();
        },
        { rootMargin: '0px 0px -30% 0px' },
      ).observe(formulaire);
    }
    window.addEventListener('scroll', mettreAJour, { passive: true });
    mettreAJour();
  }
</script>

<style>
  .dock {
    position: fixed;
    inset: auto 0 0;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px));
    background: rgba(255, 255, 255, 0.88);
    border-top: 1px solid var(--color-border);
    border-radius: 24px 24px 0 0;
    box-shadow: 0 -12px 32px -16px rgba(31, 36, 41, 0.25);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    transform: translateY(110%);
    transition: transform 450ms var(--ease-out);
  }

  .dock--visible {
    transform: none;
  }

  .dock__lien {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    min-width: 64px;
    min-height: 52px;
    border-radius: 16px;
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 650;
    text-decoration: none;
  }

  .dock__lien--whatsapp {
    color: var(--color-whatsapp);
  }

  .dock__devis {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    box-shadow: var(--shadow-accent);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  :global(body.menu-ouvert) .dock {
    display: none;
  }

  @media (min-width: 1024px) {
    .dock {
      display: none;
    }
  }
</style>
