---
/**
 * Bouton en forme de pilule. Toujours un vrai <a> (lien) ou <button> (action).
 * La flèche finale glisse vers la droite au survol.
 * Variantes : principal (ardoise), accent (rouge), secondaire (contour), whatsapp (vert).
 */
import Icon, { type NomIcone } from './Icon.astro';

type Variante = 'principal' | 'accent' | 'secondaire' | 'whatsapp';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variante?: Variante;
  icone?: NomIcone;
  iconeApres?: NomIcone;
  large?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variante = 'principal',
  icone,
  iconeApres,
  large = false,
  class: classe,
  ...reste
} = Astro.props;

const Element = href ? 'a' : 'button';
const attributs = href ? { href } : { type };
---

<Element
  class:list={['bouton', `bouton--${variante}`, large && 'bouton--large', classe]}
  {...attributs}
  {...reste}
>
  {icone && <Icon nom={icone} taille={20} />}
  <span class="bouton__texte"><slot /></span>
  {iconeApres && <Icon nom={iconeApres} taille={18} epaisseur={2.2} class="bouton__fleche" />}
</Element>

<style>
  .bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 26px;
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-text);
    font-size: var(--size-small);
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    max-width: 100%;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--speed) var(--ease),
      border-color var(--speed) var(--ease),
      color var(--speed) var(--ease),
      box-shadow var(--speed) var(--ease),
      transform var(--speed) var(--ease);
  }

  .bouton:hover {
    transform: translateY(-2px);
  }

  .bouton:active {
    transform: none;
  }

  .bouton--large {
    min-height: 60px;
    padding-inline: 32px;
    font-size: var(--size-body);
  }

  .bouton :global(.bouton__fleche) {
    transition: transform var(--speed) var(--ease);
  }

  .bouton:hover :global(.bouton__fleche) {
    transform: translate(2px, -2px);
  }

  .bouton__texte {
    padding-block: 2px;
  }

  /* Le bouton rouge : l'action principale (blanc sur #c8202b = 5,6:1). */
  .bouton--accent {
    background: var(--color-accent);
    color: #fff;
    box-shadow: var(--shadow-accent);
  }

  .bouton--accent:hover {
    background: var(--color-accent-dark);
  }

  .bouton--principal {
    background: var(--color-ink);
    color: #fff;
  }

  .bouton--principal:hover {
    background: #343b42;
  }

  .bouton--secondaire {
    background: var(--color-card);
    border-color: var(--color-border);
    color: var(--color-ink);
    box-shadow: var(--shadow-tile);
  }

  .bouton--secondaire:hover {
    border-color: var(--color-ink);
  }

  .bouton--whatsapp {
    background: var(--color-whatsapp);
    color: #fff;
  }

  .bouton--whatsapp:hover {
    background: var(--color-whatsapp-dark);
  }
</style>
