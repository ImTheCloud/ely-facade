---
/**
 * Bouton en forme de pilule. Toujours un vrai <a> (lien) ou <button> (action).
 * La flèche finale vit dans une pastille ronde qui s'anime au survol.
 * Variantes : principal (noir), accent (rouge), secondaire (contour), whatsapp (vert).
 */
import Icon, { type NomIcone } from './Icon.astro';

type Variante = 'principal' | 'accent' | 'secondaire' | 'whatsapp';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variante?: Variante;
  icone?: NomIcone;
  iconeApres?: NomIcone;
  large?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variante = 'principal',
  icone,
  iconeApres,
  large = false,
  class: classe,
  ...reste
} = Astro.props;

const Element = href ? 'a' : 'button';
const attributs = href ? { href } : { type };
---

<Element
  class:list={['bouton', `bouton--${variante}`, large && 'bouton--large', iconeApres && 'bouton--pastille', classe]}
  {...attributs}
  {...reste}
>
  {icone && <Icon nom={icone} taille={20} />}
  <span class="bouton__texte"><slot /></span>
  {
    iconeApres && (
      <span class="bouton__pastille" aria-hidden="true">
        <Icon nom={iconeApres} taille={18} epaisseur={2} />
      </span>
    )
  }
</Element>

<style>
  .bouton {
    --ombre: var(--color-ink);
    position: relative;
    display: inline-flex;
    align-items: stretch;
    justify-content: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 24px;
    border: 3px solid var(--color-ink);
    font-family: var(--font-text);
    font-size: var(--size-small);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    max-width: 100%;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--speed) var(--ease),
      color var(--speed) var(--ease),
      box-shadow var(--speed) var(--ease),
      transform var(--speed) var(--ease);
  }

  .bouton > :global(svg),
  .bouton__texte {
    align-self: center;
  }

  .bouton__texte {
    padding-block: 12px;
  }

  @media (min-width: 500px) {
    .bouton__texte {
      white-space: nowrap;
    }
  }

  .bouton:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--ombre);
  }

  .bouton:active {
    transform: none;
    box-shadow: none;
  }

  .bouton--pastille {
    padding-right: 0;
  }

  .bouton--large {
    min-height: 64px;
    padding-inline: 28px;
    font-size: var(--size-body);
  }

  .bouton--large.bouton--pastille {
    padding-right: 0;
  }

  .bouton--large .bouton__pastille {
    width: 64px;
  }

  /* La flèche vit dans un carré qui prend toute la hauteur du bouton. */
  .bouton__pastille {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    width: 56px;
    margin: -3px -3px -3px 8px;
    background: var(--color-ink);
    color: #fff;
  }

  .bouton--principal {
    background: var(--color-ink);
    color: #fff;
  }

  .bouton--principal .bouton__pastille {
    background: var(--color-accent);
  }

  .bouton--accent {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .bouton--accent .bouton__pastille {
    background: var(--color-ink);
  }

  .bouton--secondaire {
    background: transparent;
    color: var(--color-ink);
  }

  .bouton--secondaire:hover {
    background: var(--color-ink);
    color: #fff;
  }

  .bouton--whatsapp {
    background: var(--color-whatsapp);
    border-color: var(--color-whatsapp);
    color: #fff;
  }

  .bouton--whatsapp:hover {
    background: var(--color-whatsapp-dark);
  }
</style>
