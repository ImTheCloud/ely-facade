---
/**
 * Curseur avant / après : deux photos du même chantier, cadrées pour que la façade se superpose.
 * À gauche la photo « pendant les travaux », à droite la photo « terminé ».
 * Un vrai <input type="range"> couvre la photo : clavier, doigt et souris fonctionnent sans code,
 * et un geste vertical fait toujours défiler la page. À l'arrivée à l'écran, le curseur glisse une fois
 * tout seul pour montrer qu'il bouge (sauf avec « moins d'animations »).
 */
import { Image } from 'astro:assets';
import { photo, type Paire } from '../data/chantiers';
import { t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  paire: Paire;
  sizes?: string;
  class?: string;
  /** Le premier curseur de la page se charge tout de suite. */
  prioritaire?: boolean;
}

const { langue, paire, sizes = '100vw', class: classe, prioritaire = false } = Astro.props;
const textes = t(langue);
const libelles = textes.accueil.avantApres;

const cadre = (c: Paire['cadreAvant']) =>
  `--px: ${c?.px ?? 50}%; --py: ${c?.py ?? 50}%; --tx: ${c?.tx ?? 0}%; --ty: ${c?.ty ?? 0}%; --zoom: ${c?.zoom ?? 1}`;
const image = {
  widths: [480, 768, 1080, 1440, 1920],
  sizes,
  format: 'webp' as const,
  quality: 76,
  loading: prioritaire ? ('eager' as const) : ('lazy' as const),
};
---

<div class:list={['comparateur', classe]} style={`--ratio: ${paire.ratio}`} data-comparateur>
  <div class="comparateur__couche" style={cadre(paire.cadreAvant)}>
    <Image src={photo(paire.avant)} alt={textes.photos[paire.avant]} {...image} />
  </div>
  <div class="comparateur__couche comparateur__apres" style={cadre(paire.cadreApres)}>
    <Image src={photo(paire.apres)} alt={textes.photos[paire.apres]} {...image} />
  </div>

  <span class="comparateur__etiquette comparateur__etiquette--avant" aria-hidden="true">{libelles.avant}</span>
  <span class="comparateur__etiquette comparateur__etiquette--apres" aria-hidden="true">{libelles.apres}</span>

  <div class="comparateur__poignee" aria-hidden="true">
    <span class="comparateur__bouton">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 6l-6 6 6 6"></path>
        <path d="M15 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>

  <input class="comparateur__champ" type="range" min="0" max="100" step="0.5" value="50" aria-label={libelles.aria} />
</div>

<script>
  import '~/scripts/comparateur';
</script>

<style>
  .comparateur {
    --pos: 50%;
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-tile);
    background: var(--color-surface);
    isolation: isolate;
    user-select: none;
    -webkit-user-select: none;
  }

  .comparateur__couche {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* Chaque photo est cadrée (position, déplacement, agrandissement) pour que les deux façades se superposent. */
  .comparateur__couche :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--px) var(--py);
    transform: translate(var(--tx), var(--ty)) scale(var(--zoom));
    transform-origin: 0 0;
  }

  .comparateur__apres {
    clip-path: inset(0 0 0 var(--pos));
  }

  .comparateur__poignee {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 3;
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 18px rgba(0, 0, 0, 0.3);
    pointer-events: none;
  }

  .comparateur__bouton {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    margin: -29px 0 0 -29px;
    border-radius: 50%;
    background: #fff;
    color: var(--color-ink);
    box-shadow: 0 12px 30px -10px rgba(var(--voile), 0.6);
    transition: transform var(--speed) var(--ease);
  }

  .comparateur:hover .comparateur__bouton {
    transform: scale(1.06);
  }

  .comparateur__etiquette {
    position: absolute;
    top: 16px;
    z-index: 3;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: rgba(var(--voile), 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: var(--size-tiny);
    font-weight: 650;
    color: #fff;
    pointer-events: none;
  }

  .comparateur__etiquette--avant {
    left: 16px;
  }

  .comparateur__etiquette--apres {
    right: 16px;
    background: rgba(255, 255, 255, 0.86);
    color: var(--color-ink);
  }

  /* Le champ couvre toute la photo, invisible : c'est lui qui reçoit le doigt, la souris et le clavier. */
  .comparateur__champ {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
    -webkit-appearance: none;
    touch-action: pan-y;
  }

  .comparateur__champ::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 58px;
    height: 100vh;
  }

  .comparateur__champ::-moz-range-thumb {
    width: 58px;
    height: 100vh;
    border: 0;
  }

  .comparateur:has(.comparateur__champ:focus-visible) .comparateur__bouton {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 599px) {
    .comparateur {
      border-radius: var(--radius-md);
    }

    .comparateur__bouton {
      width: 48px;
      height: 48px;
      margin: -24px 0 0 -24px;
    }

    .comparateur__etiquette {
      top: 10px;
      padding: 6px 11px;
      font-size: 12px;
    }

    .comparateur__etiquette--avant {
      left: 10px;
    }

    .comparateur__etiquette--apres {
      right: 10px;
    }
  }
</style>
