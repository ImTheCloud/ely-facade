---
/**
 * Curseur avant / après : deux photos du même endroit, au même angle.
 * À gauche la photo « pendant les travaux », à droite la photo « après ».
 * Un vrai <input type="range"> couvre la photo : clavier, doigt et souris fonctionnent sans code,
 * et un geste vertical fait toujours défiler la page.
 */
import { Image } from 'astro:assets';
import { t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  avant: ImageMetadata;
  apres: ImageMetadata;
  altAvant: string;
  altApres: string;
  /** Photo du haut de page : chargée tout de suite. */
  priorite?: boolean;
  /** La photo « après » se révèle toute seule quand le curseur arrive à l'écran. */
  animer?: boolean;
  sizes?: string;
  /** Cadrage de la photo quand l'écran est plus étroit qu'elle (object-position). */
  cadrage?: string;
  class?: string;
}

const {
  langue,
  avant,
  apres,
  altAvant,
  altApres,
  priorite = false,
  animer = false,
  sizes = '100vw',
  cadrage = '50% 50%',
  class: classe,
} = Astro.props;
const libelles = t(langue).accueil.comparateur;
const image = { widths: [640, 960, 1340], sizes, format: 'webp' as const, loading: priorite ? ('eager' as const) : ('lazy' as const) };
---

<div
  class:list={['comparateur', classe]}
  data-comparateur
  data-animer={animer ? '' : undefined}
  style={`--cadrage: ${cadrage}`}
>
  <div class="comparateur__couche">
    <Image src={avant} alt={altAvant} fetchpriority={priorite ? 'high' : undefined} {...image} />
  </div>
  <div class="comparateur__couche comparateur__apres">
    <Image src={apres} alt={altApres} {...image} loading={priorite || animer ? 'eager' : 'lazy'} />
  </div>

  <span class="comparateur__etiquette comparateur__etiquette--avant" aria-hidden="true">{libelles.avant}</span>
  <span class="comparateur__etiquette comparateur__etiquette--apres" aria-hidden="true">{libelles.apres}</span>

  <div class="comparateur__poignee" aria-hidden="true">
    <span class="comparateur__bouton">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 6l-6 6 6 6"></path>
        <path d="M15 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>

  <input class="comparateur__champ" type="range" min="0" max="100" step="0.1" value="50" aria-label={libelles.aria} />

  <slot />
</div>

<script>
  import '~/scripts/comparateur';
</script>

<style>
  .comparateur {
    --pos: 50%;
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    isolation: isolate;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Avec JavaScript, un curseur animé commence sur « pendant les travaux » (avant le premier affichage). */
  :global(.js) .comparateur[data-animer] {
    --pos: 100%;
  }

  .comparateur__couche {
    position: absolute;
    inset: 0;
  }

  .comparateur__couche :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cadrage);
  }

  .comparateur__apres {
    clip-path: inset(0 0 0 var(--pos));
  }

  .comparateur__poignee {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 3;
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 18px rgba(0, 0, 0, 0.28);
    pointer-events: none;
  }

  .comparateur__bouton {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    background: rgba(31, 36, 41, 0.62);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    color: #fff;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.5);
  }

  .comparateur__etiquette {
    position: absolute;
    top: 16px;
    z-index: 3;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    font-size: var(--size-tiny);
    font-weight: 650;
    color: var(--color-ink);
    pointer-events: none;
  }

  .comparateur__etiquette--avant {
    left: 16px;
  }

  .comparateur__etiquette--apres {
    right: 16px;
  }

  /* Le champ couvre toute la photo, invisible : c'est lui qui reçoit le doigt, la souris et le clavier. */
  .comparateur__champ {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
    -webkit-appearance: none;
    touch-action: pan-y;
  }

  .comparateur__champ::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 56px;
    height: 100vh;
  }

  .comparateur__champ::-moz-range-thumb {
    width: 56px;
    height: 100vh;
    border: 0;
  }

  .comparateur:has(.comparateur__champ:focus-visible) .comparateur__bouton {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Un halo discret tant que personne n'a touché au curseur. */
    .comparateur:not(.est-touche) .comparateur__bouton::after {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.9);
      animation: halo 2.4s var(--ease-out) infinite;
    }

    @keyframes halo {
      from {
        transform: scale(1);
        opacity: 0.9;
      }
      to {
        transform: scale(1.7);
        opacity: 0;
      }
    }
  }
</style>
