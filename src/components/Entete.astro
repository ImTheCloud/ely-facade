---
/**
 * En-tête flottant.
 * - Transparent en haut de page, puis pilule floutée dès qu'on défile.
 * - Se cache quand on descend, revient dès qu'on remonte.
 * - Sur mobile : bouton « Menu » qui ouvre un panneau plein écran.
 */
import Bouton from './Bouton.astro';
import Logo from './Logo.astro';
import SelecteurLangue from './SelecteurLangue.astro';
import { entreprise, lienDevis, lienWhatsApp } from '../data/entreprise';
import { chemin, liensNavigation, t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  cheminActuel: string;
}

const { langue, cheminActuel } = Astro.props;
const textes = t(langue);
const liens = liensNavigation(langue);
const devis = lienDevis(langue);
const estActif = (href: string) => cheminActuel.startsWith(href);
---

<header class="entete sur-noir" data-entete>
  <div class="entete__barre">
    <a href={chemin('accueil', langue)} class="entete__logo" aria-label={textes.entete.accueilAria}>
      <Logo surFonce />
    </a>

    <nav class="entete__nav" aria-label={textes.entete.menuAria}>
      {
        liens.map((lien) => (
          <a href={lien.href} aria-current={estActif(lien.href) ? 'page' : undefined}>
            {lien.libelle}
          </a>
        ))
      }
    </nav>

    <div class="entete__actions">
      <SelecteurLangue langue={langue} cheminActuel={cheminActuel} surFonce />
      <Bouton href={devis} variante="accent" iconeApres="fleche-diag">{textes.actions.devis}</Bouton>
    </div>

    <!-- Téléphone : FR / NL toujours à portée de main, à côté du menu. -->
    <div class="entete__langue-mobile">
      <SelecteurLangue langue={langue} cheminActuel={cheminActuel} surFonce compact />
    </div>

    <button
      type="button"
      class="entete__burger"
      id="bouton-menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
      data-ouvrir={textes.entete.ouvrirMenu}
      data-fermer={textes.entete.fermerMenu}
    >
      <span data-texte-menu={textes.entete.menu} data-texte-fermer={textes.entete.fermer}>{textes.entete.menu}</span>
      <span class="entete__burger-traits" aria-hidden="true"><span></span><span></span></span>
      <span class="sr-only" data-libelle>{textes.entete.ouvrirMenu}</span>
    </button>
  </div>

  <div class="panneau" id="menu-mobile" data-panneau hidden data-lenis-prevent>
    <nav class="panneau__nav" aria-label={textes.entete.menuAria}>
      {
        liens.map((lien, i) => (
          <a href={lien.href} style={`--i: ${i}`}>
            <span class="panneau__num">0{i + 1}</span>
            <span class="panneau__lien">{lien.libelle}</span>
          </a>
        ))
      }
    </nav>

    <div class="panneau__bas">
      <Bouton href={devis} variante="accent" iconeApres="fleche-diag" large>{textes.actions.devis}</Bouton>
      <div class="panneau__contact">
        <span class="panneau__label">{textes.entete.contactDirect}</span>
        <a href={`tel:${entreprise.telephoneLien}`}>{entreprise.telephoneAffiche}</a>
        <a href={lienWhatsApp(textes.whatsappMessage)} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`mailto:${entreprise.email}`}>{entreprise.email}</a>
      </div>
    </div>
  </div>
</header>

<script>
  import { bloquerDefilement } from '~/scripts/site';

  const entete = document.querySelector<HTMLElement>('[data-entete]');
  const bouton = document.getElementById('bouton-menu');
  const panneau = document.querySelector<HTMLElement>('[data-panneau]');
  const libelle = bouton?.querySelector<HTMLElement>('[data-libelle]');
  const texteVisible = bouton?.querySelector<HTMLElement>('[data-texte-menu]');

  /* --- Apparence selon le défilement --- */
  if (entete) {
    let dernier = window.scrollY;
    const mettreAJour = () => {
      const y = window.scrollY;
      if (!document.body.classList.contains('menu-ouvert')) {
        entete.classList.toggle('entete--cache', y > dernier && y > 320);
      }
      dernier = y;
    };
    window.addEventListener('scroll', mettreAJour, { passive: true });
    mettreAJour();
  }

  /* --- Menu mobile --- */
  if (bouton && panneau) {
    const basculer = (ouvert: boolean) => {
      bouton.setAttribute('aria-expanded', String(ouvert));
      if (libelle) libelle.textContent = (ouvert ? bouton.dataset.fermer : bouton.dataset.ouvrir) ?? '';
      if (texteVisible) texteVisible.textContent = (ouvert ? texteVisible.dataset.texteFermer : texteVisible.dataset.texteMenu) ?? '';
      panneau.hidden = !ouvert;
      if (ouvert) entete?.classList.remove('entete--cache');
      document.body.classList.toggle('menu-ouvert', ouvert);
      bloquerDefilement(ouvert);
      // Deux images d'attente : le panneau doit d'abord exister fermé pour que l'ouverture s'anime.
      if (ouvert) requestAnimationFrame(() => requestAnimationFrame(() => panneau.classList.add('panneau--ouvert')));
      else panneau.classList.remove('panneau--ouvert');
    };

    bouton.addEventListener('click', () => basculer(bouton.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && bouton.getAttribute('aria-expanded') === 'true') {
        basculer(false);
        bouton.focus();
      }
    });

    // Un lien d'ancre sur la même page referme le menu.
    panneau.querySelectorAll('a').forEach((lien) => lien.addEventListener('click', () => basculer(false)));

    window.matchMedia('(min-width: 1024px)').addEventListener('change', (evenement) => {
      if (evenement.matches) basculer(false);
    });
  }
</script>

<style is:global>
  /* Menu ouvert : la page dessous ne bouge plus (iPhone compris), l'en-tête reste affiché. */
  html:has(body.menu-ouvert),
  body.menu-ouvert {
    overflow: hidden;
    overscroll-behavior: none;
  }

  body.menu-ouvert .entete {
    transform: none;
  }
</style>

<style>
  .entete {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    background: var(--color-ink);
    border-bottom: var(--trait) solid var(--color-accent);
    transition: transform 400ms var(--ease-out);
  }

  .entete--cache {
    transform: translateY(-110%);
  }

  /* Toujours au-dessus du panneau du menu (z-index 1). */
  .entete__barre {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    max-width: calc(var(--content-max) + var(--gutter) * 2);
    min-height: var(--header-h);
    margin: 0 auto;
    padding: 8px var(--gutter);
  }

  .entete__logo {
    display: flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
    flex-shrink: 0;
  }

  .entete__logo :global(.logo) {
    height: 44px;
  }

  .entete__nav,
  .entete__actions {
    display: none;
  }

  .entete__langue-mobile {
    margin-left: auto;
  }

  /* --- Bouton menu : carré rouge --- */
  .entete__burger {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 10px;
    height: 48px;
    padding: 0 14px;
    background: var(--color-accent);
    border: 0;
    color: #fff;
    font: 800 14px/1 var(--font-text);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .entete__burger-traits {
    position: relative;
    display: inline-block;
    width: 22px;
    height: 16px;
  }

  .entete__burger-traits span {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: #fff;
    transition: transform 300ms var(--ease-out);
  }

  .entete__burger-traits span:first-child {
    top: 2px;
  }

  .entete__burger-traits span:last-child {
    top: 11px;
  }

  .entete__burger[aria-expanded='true'] .entete__burger-traits span:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }

  .entete__burger[aria-expanded='true'] .entete__burger-traits span:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  /* --- Panneau plein écran, noir --- */
  .panneau {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: calc(var(--header-h) + 24px) var(--gutter) calc(28px + env(safe-area-inset-bottom, 0px));
    overscroll-behavior: contain;
    background: var(--color-ink);
    color: var(--color-on-ink);
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 500ms var(--ease-out);
  }

  .panneau--ouvert {
    clip-path: inset(0);
  }

  .panneau__nav {
    display: flex;
    flex-direction: column;
  }

  .panneau__nav a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 2px solid var(--color-line-on-ink);
    color: #fff;
    text-decoration: none;
    opacity: 0;
    transform: translateX(-24px);
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out);
    transition-delay: calc(150ms + var(--i) * 60ms);
  }

  .panneau--ouvert .panneau__nav a {
    opacity: 1;
    transform: none;
  }

  .panneau__num {
    font-size: 14px;
    font-weight: 800;
    color: var(--color-accent-vif);
  }

  .panneau__lien {
    font-family: var(--font-title);
    font-size: clamp(48px, 13vw, 76px);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .panneau__bas {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .panneau__bas :global(.bouton) {
    width: 100%;
    justify-content: space-between;
  }

  .panneau__contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .panneau__label {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-on-ink-label);
  }

  .panneau__contact a {
    color: #fff;
    font-size: 18px;
    text-decoration: none;
    padding: 6px 0;
  }

  @media (max-width: 380px) {
    .entete__barre {
      gap: 6px;
    }

    .entete__logo :global(.logo) {
      height: 38px;
    }

    .entete__burger {
      padding: 0 10px;
      gap: 8px;
      font-size: 13px;
    }

    .entete__langue-mobile :global(.langues__lien) {
      min-width: 34px;
    }
  }

  @media (min-width: 1024px) {
    .entete__logo :global(.logo) {
      height: 52px;
    }

    .entete__nav {
      display: flex;
      gap: 6px;
    }

    .entete__nav a {
      position: relative;
      padding: 12px 16px;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #fff;
      text-decoration: none;
    }

    .entete__nav a::after {
      content: '';
      position: absolute;
      left: 16px;
      right: 16px;
      bottom: 4px;
      height: 3px;
      background: var(--color-accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--speed) var(--ease);
    }

    .entete__nav a:hover::after,
    .entete__nav a[aria-current='page']::after {
      transform: scaleX(1);
    }

    .entete__actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .entete__burger,
    .entete__langue-mobile,
    .panneau {
      display: none;
    }
  }
</style>
