{
  "name": "ely-facade",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Au plus 5 envois du formulaire par minute et par visiteur : un robot ne peut pas inonder la boîte de devis.
  "ratelimits": [
    {
      "name": "LIMITEUR_DEVIS",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
